# Redirection HTTPS obligatoire (document de passage, section 3)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Anciennes URLs : /configurateur reste la page 3D (/personnaliser, seul
# mode restant sur cette page) ; /simulateur redirige vers le quiz
# /commencer, seul point d'entrée rapide du site depuis la fusion des deux
# parcours de vente en un seul (les paramètres de requête existants, ex.
# ?technique=serigraphie, sont conservés grâce à QSA).
<IfModule mod_rewrite.c>
  RewriteRule ^configurateur/?$ /personnaliser?mode=3d [R=301,L,QSA]
  RewriteRule ^simulateur/?$ /commencer [R=301,L,QSA]
  RewriteRule ^personnalisateur/?$ /personnaliser [R=301,L,QSA]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache des ressources statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Protection temporaire par mot de passe avant le lancement public.
# Remplace le mode maintenance (503) : le site reste accessible (donc
# testable avec de vrais clients/partenaires) mais protégé par une
# authentification HTTP Basic — sans impact sur le référencement, Google
# ne pouvant simplement pas indexer tant que la protection est active
# (comme avec le 503 précédent). Identifiant : presstee.
# Pas de fichier .htpasswd ni de chemin absolu (indisponible en .htaccess
# sur l'hébergement mutualisé OVH) : le mot de passe est vérifié
# directement via l'en-tête Authorization envoyé par le navigateur.
# Pour lever la protection : supprimer ce bloc, puis redéployer.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Authorization} !^Basic\ cHJlc3N0ZWU6cHJlc3N0ZWUxNg==$
  RewriteRule ^ - [R=401,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set WWW-Authenticate "Basic realm=\"Presstee\""
</IfModule>
