---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import '../styles/personnalisateur.css';
---

<Layout title="Presstee — Personnalisateur" description="Composez votre textile personnalisé : vêtement, couleur, visuel et technique de marquage.">
	<header>
		<div class="wrap nav">
			<a class="brand" href="/">
				<Logo size={32} variant="icone" />
			</a>
			<div class="steps">
				<i class="done"><b>1</b>Textile</i><em>—</em>
				<i class="done"><b>2</b>Visuel</i><em>—</em>
				<i><b>3</b>Validation</i>
			</div>
		</div>
	</header>

	<div class="wrap">
		<div class="intro">
			<h1>Composez votre textile personnalisé.</h1>
			<p>Choisissez un modèle, déposez votre visuel, placez-le. Nous analysons votre fichier au passage et vous disons quelle technique convient à votre projet et à votre quantité.</p>
		</div>

		<div class="layout3">

			<div class="panel">

				<div class="block">
					<h3><b>1</b>Support</h3>
					<div class="support-name">T-shirt col rond<br>unisexe, 180 g/m²</div>
					<p class="support-spec">100 % coton · manches courtes · XS à XXL</p>
					<a class="btn alt" href="/produits/t-shirts">Changer de support</a>
				</div>

				<div class="block">
					<div class="blockhead"><h3><b>2</b>Coloris</h3><span class="muted" id="colorName"></span></div>
					<div class="swatches" id="colors"></div>
					<p class="hint" id="darkNote"></p>
				</div>

				<div class="block" id="placeBlock" style="display:none">
					<h3><b>3</b>Emplacement</h3>
					<div class="stack-opts" id="place">
						<button data-p="face" class="on"><strong>Face</strong><em>28 cm max</em></button>
						<button data-p="coeur"><strong>Cœur</strong><em>10 cm max</em></button>
						<button data-p="dos"><strong>Dos</strong><em>30 cm max</em></button>
					</div>
					<p class="hint">Un seul emplacement par pièce. Le recto-verso se chiffre comme deux marquages.</p>
				</div>

				<div class="block" id="adjust" style="display:none">
					<h3><b>4</b>Taille du visuel</h3>
					<div class="widthctl">
						<button id="wMinus" aria-label="Réduire">−</button>
						<div class="widthval" id="wCm"></div>
						<button id="wPlus" aria-label="Agrandir">+</button>
					</div>
					<p class="hint" id="wPct"></p>
				</div>

			</div>

			<div class="viewer">
				<div class="frame" id="frame">
					<div class="zoomwrap" id="zoomwrap"><div class="stage" id="stage"></div></div>
					<div class="zoomctl">
						<button id="zOut" aria-label="Dézoomer">−</button>
						<span id="zVal">100 %</span>
						<button id="zIn" aria-label="Zoomer">+</button>
						<button id="zRst" aria-label="Réinitialiser le zoom" style="font-size:13px">⟲</button>
					</div>
				</div>
				<div class="strip">
					<div class="t">Vues du modèle</div>
					<div class="shots" id="shots"></div>
				</div>
				<div class="filebar">
					<div class="drop" id="drop">
						<strong>Déposez votre fichier</strong>
						<p>ou cliquez pour parcourir — PNG, JPG ou SVG</p>
					</div>
					<input type="file" id="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
					<div id="fileInfo"></div>
					<div class="diag" id="diag" style="display:none"></div>
				</div>
			</div>

			<div class="panel">

				<div class="block">
					<div class="blockhead"><h3><b>5</b>Répartition des tailles</h3><span class="muted" id="sizeTotal"></span></div>
					<div id="sizeRows"></div>
				</div>

				<div class="block">
					<h3><b>6</b>Technique</h3>
					<div class="techs" id="techs"></div>
					<div class="reco" id="recoBox"></div>
					<button class="mini-btn" id="resetTech" style="display:none">Revenir à la recommandation</button>
				</div>

				<div class="block">
					<h3><b>7</b>Délai</h3>
					<div class="stack-opts" id="delai">
						<button data-d="standard" class="on"><strong>Standard</strong><em>10 jours ouvrés</em></button>
						<button data-d="express"><strong>Express</strong><em>5 jours ouvrés</em></button>
					</div>
				</div>

				<div class="recap">
					<div id="recap"></div>
					<button class="btn" id="order">Demander le devis</button>
					<p class="hint">Réponse sous 24 h ouvrées · projet enregistré dans ce navigateur.</p>
				</div>

			</div>

		</div>
	</div>

	<script>
		import { init } from '../scripts/personnalisateur/main';
		init();
	</script>
</Layout>
