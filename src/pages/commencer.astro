---
// Quiz guidé — seul parcours de vente rapide du site ("Trois questions,
// une recommandation claire, puis direction le configurateur déjà
// pré-rempli"). Réutilise reco() et seedFromItem() — aucune nouvelle
// logique de recommandation ou de tarification. Le multiproduit et le
// modèle 3D cliquable pour choisir l'emplacement vivent dans
// scripts/commencer.ts et scripts/commencer-3d.ts.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParcoursBar from '../components/ParcoursBar.astro';
import '../styles/global.css';
import '../styles/produits.css';
import '../styles/simulateur.css';
import '../styles/commencer.css';
---

<Layout title="Commander — Presstee" description="Trois questions, une recommandation de technique et de textile, puis direction le configurateur déjà pré-rempli.">
	<Header />
	<ParcoursBar step={1} />
	<main>
		<section class="qz-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Commander</div>
				<h1>Trois questions,<br />une recommandation claire.</h1>
				<p>Répondez en quelques clics : on vous propose une technique, un textile et un ordre de prix, puis vous pouvez configurer votre visuel en 3D directement à partir de ce résultat.</p>
			</div>
		</section>

		<section class="qz-body">
			<div class="wrap qz-wrap">
				<div class="qzLayout" id="qzLayout">
					<div class="qzCard">
						<div class="qzProgress" id="qzProgress"></div>
						<div id="qzScreen"></div>
						<div class="qzNav" id="qzNav">
							<button type="button" class="btn btn-outline" id="qzPrev">Précédent</button>
							<button type="button" class="btn" id="qzNext">Suivant</button>
						</div>
					</div>
					<aside class="qz3d">
						<model-viewer
							id="qzStage"
							camera-controls
							touch-action="pan-y"
							interaction-prompt="none"
							shadow-intensity="1"
							camera-orbit="0deg 85deg 105%"
							min-camera-orbit="auto 55deg auto"
							max-camera-orbit="auto 115deg auto"
						></model-viewer>
						<p class="qz3d-hint">Cliquez directement sur le modèle pour choisir l'emplacement du visuel.</p>
					</aside>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { initCommencer } from '../scripts/commencer';
	initCommencer();
</script>
