---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroAccueil from '../components/HeroAccueil.astro';
import ProcessAccordion from '../components/ProcessAccordion.astro';
import RealisationsGrid from '../components/RealisationsGrid.astro';
import { siteConfig } from '../config/site';
import { SECTEURS } from '../data/secteurs';
import '../styles/global.css';
import '../styles/techniques.css';
---

<Layout title={`${siteConfig.nom} — ${siteConfig.baseline}`} description="Atelier de textile personnalisé à Angoulême : sérigraphie, broderie et transfert. Configurez votre t-shirt, sweat ou casquette en 3D et commandez en ligne.">
	<Header />

	<main id="top">

		<HeroAccueil />

		<section class="s-indigo">
			<div class="wrap split">
				<div>
					<div class="humanScale">
						<h2>Le textile personnalisé,<br />à taille humaine.</h2>
						<svg class="humanScale-figure" viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="4.2" r="3" fill="#FFC500" stroke="none" />
							<path d="M12 7.2v11" />
							<path d="M12 11l-6 4" />
							<path d="M12 11l6 4" />
							<path d="M12 18l-4.5 14" />
							<path d="M12 18l4.5 14" />
						</svg>
					</div>
					<p class="lede">Presstee est un atelier, pas une plateforme. Nous choisissons les textiles, nous réalisons nous-mêmes le marquage et nous suivons chaque étape du premier échange jusqu'à la livraison.</p>
					<p class="lede">Concrètement : moins d'intermédiaires entre votre projet et le vêtement que vous recevez, et un conseiller personnalisé qui suit votre projet.</p>
				</div>
				<div class="valueChain">
					<span class="valueChain-eyebrow">Notre chaîne, de bout en bout</span>
					<ol class="valueChain-list">
						<li class="valueChain-item">
							<span class="valueChain-mark regmark" aria-hidden="true"></span>
							<div class="valueChain-body">
								<h3>Une qualité contrôlée</h3>
								<p>Nous vérifions vos fichiers, les dimensions et le positionnement, puis vous validez un bon à tirer : rien ne part en production sans votre accord.</p>
							</div>
						</li>
						<li class="valueChain-item">
							<span class="valueChain-mark regmark" aria-hidden="true"></span>
							<div class="valueChain-body">
								<h3>Un coût allégé</h3>
								<p>Entre vous et le vêtement fini, il n'y a que nous. Pas d'agence qui sous-traite, pas de marge ajoutée en cours de route.</p>
							</div>
						</li>
						<li class="valueChain-item">
							<span class="valueChain-mark regmark" aria-hidden="true"></span>
							<div class="valueChain-body">
								<h3>Des délais que nous tenons</h3>
								<p>Nos machines et notre planning sont entre nos mains : le délai annoncé ne dépend pas de la file d'attente d'un prestataire.</p>
							</div>
						</li>
						<li class="valueChain-item">
							<span class="valueChain-mark regmark" aria-hidden="true"></span>
							<div class="valueChain-body">
								<h3>Un accompagnement design</h3>
								<p>Pas de visuel prêt ? Décrivez-nous votre projet dans le configurateur : Presstee peut créer ou adapter le design avec vous.</p>
							</div>
						</li>
					</ol>
				</div>
			</div>
		</section>

		<section id="techniques" class="s-jaune">
			<div class="wrap">
				<div class="head-center">
					<div class="humanScale center">
						<h2>Bien choisir, c'est avant tout comprendre.</h2>
						<svg class="humanScale-figure" viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="4.2" r="3" fill="#FFC500" stroke="none" />
							<path d="M11 7.2v10" />
							<path d="M11 10l-5 3" />
							<path d="M11 9.3l4-1.8" />
							<circle cx="17.3" cy="5.8" r="2.6" />
							<circle cx="17.3" cy="5.8" r="1.2" fill="currentColor" stroke="none" />
							<path d="M19.3 7.7l1.8 1.8" />
							<path d="M11 17.2l-4 14" />
							<path d="M11 17.2l4 14" />
						</svg>
					</div>
					<p style="color:#5C4A1F">Le textile et la technique de marquage influencent directement la qualité du rendu, sa durabilité, les délais et le prix. Voici de quoi décider en connaissance de cause.</p>
				</div>
				<div class="trio" id="techCarousel">
					<div class="card">
						<svg class="card-figure" viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="4.2" r="3" fill="#FFC500" stroke="none" />
							<path d="M12 7.2v8" />
							<path d="M12 11l-5 2.5" />
							<path d="M12 11l5 2.5" />
							<path d="M5.5 15.5h13" />
							<path d="M12 15.2l-4 13.8" />
							<path d="M12 15.2l4 13.8" />
						</svg>
						<h3>Les techniques de marquage</h3>
						<p>Comment fonctionne chaque technique, à quoi ressemble le rendu, combien de temps elle tient au lavage, à partir de quelle quantité elle devient intéressante.</p>
						<div class="chips">
							<a class="chip" href="/techniques/serigraphie">Sérigraphie</a>
							<a class="chip" href="/techniques/broderie">Broderie</a>
							<a class="chip" href="/techniques/transfert-monochrome">Transfert monochrome</a>
							<a class="chip" href="/techniques/transfert-quadrichromie">Transfert quadrichromie</a>
						</div>
					</div>
					<div class="card">
						<svg class="card-figure" viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="4.2" r="3" fill="#FFC500" stroke="none" />
							<path d="M12 7.2v6" />
							<path d="M12 9l-4 2" />
							<path d="M12 9l4 2" />
							<rect x="7.5" y="10.5" width="9" height="7" rx="1.2" />
							<path d="M12 18.2l-4 13.8" />
							<path d="M12 18.2l4 13.8" />
						</svg>
						<h3>Le textile</h3>
						<p>Le grammage, la matière et l'origine du vêtement pèsent autant sur le rendu et sur le prix que la technique de marquage. Toutes ces informations sont indiquées sur chaque page produit.</p>
						<div class="chips">
							<a class="chip" href="/produits/t-shirts">T-shirts</a>
							<a class="chip" href="/produits/polos">Polos</a>
							<a class="chip" href="/produits/sweats">Sweats</a>
							<a class="chip" href="/produits/chemises">Chemises</a>
							<a class="chip" href="/produits/tote-bags">Tote bags</a>
						</div>
					</div>
					<div class="card" id="pourqui">
						<div class="card-figure-row" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Football">
								<circle cx="10" cy="4" r="2.4" fill="#FFC500" stroke="none" />
								<path d="M10 6.4v6" />
								<path d="M10 8.5l-3.5 2" />
								<path d="M10 8.5l3.5-1" />
								<path d="M10 12.4l-2 8" />
								<path d="M10 12.4l5 3 2 5" />
								<circle cx="18.5" cy="21.5" r="1.4" />
							</svg>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Service au bar">
								<circle cx="10" cy="4" r="2.4" fill="#FFC500" stroke="none" />
								<path d="M10 6.4v6.5" />
								<path d="M10 8.8l-3 1.5" />
								<path d="M10 8.5l4-2.5" />
								<rect x="13" y="3.5" width="2.4" height="3.4" rx="0.4" />
								<path d="M10 12.9l-2.6 8" />
								<path d="M10 12.9l2.8 8" />
							</svg>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Chant">
								<circle cx="10" cy="4" r="2.4" fill="#FFC500" stroke="none" />
								<path d="M10 6.4v6.5" />
								<path d="M10 9l-3.5-1.5" />
								<path d="M10 8.6l2.6-3.6" />
								<circle cx="13.2" cy="4" r="1.1" fill="currentColor" stroke="none" />
								<path d="M10 12.9l-2.6 8" />
								<path d="M10 12.9l3.4 7.6" />
							</svg>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Karting">
								<circle cx="9" cy="5" r="2.3" fill="#FFC500" stroke="none" />
								<path d="M9 7.3v4.5" />
								<path d="M9 9.5l3-1" />
								<path d="M9 9.5l3 1.5" />
								<circle cx="14.5" cy="9.5" r="2.1" />
								<path d="M9 11.8l4 .5 1 6" />
								<path d="M9 11.8l-1 7" />
							</svg>
						</div>
						<h3>Des conseils par activité</h3>
						<p>Les contraintes d'une association ne sont pas celles d'un restaurant. Nous avons rassemblé les besoins récurrents, les textiles adaptés et les budgets réalistes par profil.</p>
						<div class="chips">
							{SECTEURS.map((s) => (
								<a class="chip" href={`/secteurs/${s.slug}`}>{s.nom}</a>
							))}
						</div>
					</div>
				</div>
				<!-- Défilement automatique réservé au mobile (cf. techniques.css et
				     le script plus bas) : sur ordinateur, .trio reste la grille à 3
				     colonnes normale et ces points restent masqués. -->
				<div class="techCarousel-dots" id="techCarouselDots" aria-hidden="true">
					<span class="techCarousel-dot on"></span>
					<span class="techCarousel-dot"></span>
					<span class="techCarousel-dot"></span>
				</div>
			</div>
		</section>

		<ProcessAccordion />

		<section id="commander" class="s-commander">
			<div class="wrap">
				<div class="head-center">
					<h2>Trois façons de commander.</h2>
				</div>
				<div class="trio trio-epure">
					<div class="way">
						<div class="way-top">
							<div class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="4.6" r="2.4" fill="currentColor" stroke="none" /><path d="M8 7v5" /><path d="M8 9.4l-3 1.8" /><path d="M8 9.6l4.2 1.2" /><rect x="10" y="15" width="12" height="4.2" rx="1" /><path d="M12.5 17.1h1.2M15.3 17.1h1.2M18.1 17.1h1.2" /><path d="M8 12l-2.2 8.8" /><path d="M8 12l1.5 8.8" /></svg></div>
							<h3>En ligne</h3>
						</div>
						<p>Catalogue, test guidé ou configurateur 3D : à vous de choisir votre point de départ.</p>
						<a class="go" href="/commencer">Lancer le test</a>
					</div>
					<div class="way">
						<div class="way-top">
							<div class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="4.6" r="2.5" fill="currentColor" stroke="none" /><path d="M8 7v5.4" /><path d="M8 9.4l-3 2" /><path d="M8 9.6l3.8 1" /><rect x="12.2" y="8.4" width="7" height="9" rx="1" /><path d="M14.2 11.4h3M14.2 13.9h3M14.2 16.4h1.8" /><path d="M8 12.4l-1.8 8.6" /><path d="M8 12.4l2 8.6" /></svg></div>
							<h3>Par formulaire</h3>
						</div>
						<p>Décrivez votre projet, recevez une recommandation et un devis chiffré.</p>
						<a class="go" href="/contact">Nous contacter</a>
					</div>
					<div class="way">
						<div class="way-top">
							<div class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="5" r="2.4" fill="currentColor" stroke="none" /><path d="M8 7.4v6" /><path d="M8 9.8l-3 2" /><path d="M8 9l1.8-2.3" /><path d="M9.8 3.6L13.2 7.4" /><circle cx="9.8" cy="3.6" r="1.3" fill="currentColor" stroke="none" /><circle cx="13.2" cy="7.4" r="1.3" fill="currentColor" stroke="none" /><path d="M8 13.4l-2.6 7.6" /><path d="M8 13.4l3 7.6" /></svg></div>
							<h3>Par téléphone ou mail</h3>
						</div>
						<div class="coord">
							<a href={`tel:${siteConfig.telephone.replace(/\s/g, '')}`}>{siteConfig.telephone}</a>
							<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<RealisationsGrid />

	</main>

	<Footer />
</Layout>

<script>
	// Carrousel "Bien choisir" — mobile uniquement (Milio, 2026-09-15) :
	// sur ordinateur .trio reste la grille normale et ce script ne fait
	// rien. Sur mobile, .trio devient un rail à défilement horizontal
	// (scroll-snap, cf. techniques.css) que ce script fait avancer tout
	// seul, carte par carte, avec des points pour qu'on comprenne que ça
	// défile. Un appui quelconque sur le rail arrête l'avance automatique
	// pour de bon (« si on appuie, ça bloque ») — on laisse alors le
	// visiteur swiper librement, le scroll-snap natif prenant le relais.
	const mq = window.matchMedia('(max-width: 900px)');
	const track = document.getElementById('techCarousel');
	const dotsWrap = document.getElementById('techCarouselDots');

	if (track && dotsWrap) {
		const cards = [...track.children] as HTMLElement[];
		const dots = [...dotsWrap.children] as HTMLElement[];
		let index = 0;
		let timer: number | null = null;
		let paused = false;

		function setActive(i: number): void {
			index = ((i % cards.length) + cards.length) % cards.length;
			dots.forEach((d, n) => d.classList.toggle('on', n === index));
		}
		function goTo(i: number): void {
			setActive(i);
			// scrollIntoView() a été essayé ici, mais même avec block:'nearest'
			// il peut aussi faire défiler la PAGE verticalement pour amener la
			// carte dans le viewport si la section n'y est pas déjà (bug
			// signalé par Milio, 2026-09-15 : la page sautait toute seule
			// jusqu'à cette section peu après le chargement). track.scrollTo()
			// ne touche que le défilement horizontal du rail lui-même.
			const card = cards[index];
			track.scrollTo({ left: card.offsetLeft - (track.clientWidth - card.clientWidth) / 2, behavior: 'smooth' });
		}
		function stop(): void {
			if (timer != null) {
				window.clearInterval(timer);
				timer = null;
			}
		}
		function start(): void {
			if (paused || !mq.matches || document.hidden || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			stop();
			timer = window.setInterval(() => goTo(index + 1), 4200);
		}
		function pauseForGood(): void {
			if (paused) return;
			paused = true;
			stop();
		}

		// Le scroll-snap natif peut aussi bien venir d'un swipe que du
		// scrollIntoView programmatique ci-dessus : on recale juste l'index
		// et les points sur la carte réellement au centre après coup,
		// plutôt que de dupliquer la détection swipe/auto.
		let scrollRaf = 0;
		track.addEventListener(
			'scroll',
			() => {
				if (scrollRaf) return;
				scrollRaf = requestAnimationFrame(() => {
					scrollRaf = 0;
					const trackMid = track.getBoundingClientRect().left + track.clientWidth / 2;
					let closest = 0;
					let closestDist = Infinity;
					cards.forEach((c, i) => {
						const r = c.getBoundingClientRect();
						const dist = Math.abs(r.left + r.width / 2 - trackMid);
						if (dist < closestDist) {
							closestDist = dist;
							closest = i;
						}
					});
					setActive(closest);
				});
			},
			{ passive: true }
		);
		track.addEventListener('pointerdown', pauseForGood, { passive: true });
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		mq.addEventListener('change', () => (mq.matches ? start() : stop()));

		start();
	}
</script>
