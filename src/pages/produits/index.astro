---
// Page d'accueil du catalogue produits — remplace l'ancienne page qui
// listait directement les t-shirts (déplacée telle quelle vers
// /produits/t-shirts). Reprend le gabarit fourni par Milio
// (Accueil produits.dc.html) recréé en Astro avec les conventions du
// repo : composants Header/Footer, données réelles plutôt que les
// valeurs d'exemple du gabarit, pas de photo produit tant qu'aucune
// vraie photo n'existe (le gabarit les rendait déjà optionnelles via
// des props d'affichage — ici la décision est prise une fois pour
// toutes plutôt que configurable).
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TSHIRTS } from '../../data/tshirts';
import { LABELS_GENRE, LABELS_TYPE_TEXTILE, type TypeTextile } from '../../lib/produits-types';
import { prixAPartirDe, PALIERS_TARIF } from '../../config/tarification';
import { seuils } from '../../config/parametres-metier';
import '../../styles/global.css';
import '../../styles/produits.css';

const prixTShirt = prixAPartirDe(Math.min(...TSHIRTS.map((t) => t.baseCost)));

const familles: { type: TypeTextile; desc: string; actif: boolean }[] = [
	{ type: 't-shirts', desc: 'De 130 à 300 g/m², col rond, col V ou oversize, en coupes homme, femme, enfant et unisexe.', actif: true },
	{ type: 'sweats', desc: 'Crewneck, capuche et zippés.', actif: false },
	{ type: 'polos', desc: 'Piqué coton, broderie poitrine.', actif: false },
	{ type: 'chemises', desc: 'Coupes ajustées, marquage discret.', actif: false },
	{ type: 'casquettes', desc: '5 et 6 panneaux, broderie frontale.', actif: false },
	{ type: 'bagagerie', desc: 'Totes, sacs à dos, sacs de sport.', actif: false },
];

const bestSellers = [...TSHIRTS].sort((a, b) => a.baseCost - b.baseCost).slice(0, 6);

const margeMin = Math.min(...PALIERS_TARIF.map((p) => p.marge));
const margeMax = Math.max(...PALIERS_TARIF.map((p) => p.marge));
function barWidth(marge: number): number {
	if (margeMax === margeMin) return 100;
	return Math.round((32 + ((marge - margeMin) / (margeMax - margeMin)) * 68) * 10) / 10;
}
---

<Layout title="Produits — Presstee" description="Le catalogue textile Presstee : t-shirts en ligne, sweats/polos/chemises/casquettes/bagagerie à venir. Grammages, coupes et grille de prix dégressive.">
	<Header />
	<main>
		<section class="phome-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Produits</div>
				<div class="phome-hero-grid">
					<div>
						<h1>Le catalogue<br />textile.</h1>
						<p>Des bases sélectionnées pour bien recevoir le marquage, à personnaliser en sérigraphie, transfert ou broderie. Atelier à Angoulême, séries à partir de 10 pièces.</p>
						<div class="phome-hero-cta">
							<a class="btn" href="/produits/t-shirts">Voir le catalogue</a>
							<a class="btn btn-jaune" href="/configurateur">Ouvrir le configurateur</a>
						</div>
					</div>
					<div class="phome-stats">
						<div>
							<div class="phome-stat-num">{TSHIRTS.length}</div>
							<div class="phome-stat-label">références textiles en ligne</div>
						</div>
						<div>
							<div class="phome-stat-num">{seuils.quantitePiecesSerigraphie} / {seuils.quantitePiecesBroderie}</div>
							<div class="phome-stat-label">pièces minimum en sérigraphie / broderie</div>
						</div>
						<div>
							<div class="phome-stat-num">{PALIERS_TARIF.length}</div>
							<div class="phome-stat-label">paliers de prix dégressifs, jusqu'à {PALIERS_TARIF[PALIERS_TARIF.length - 1].max} pièces</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="phome-section">
			<div class="wrap">
				<div class="phome-section-head">
					<h2>Par famille de textile</h2>
					<span class="phome-section-note">Les t-shirts sont en ligne, le reste arrive au fil des accords fournisseurs.</span>
				</div>
				<div class="fam-grid">
					<div class="fam-card fam-card-big">
						<div class="fam-eyebrow">Famille 01</div>
						<h3>T-shirts</h3>
						<p>{familles[0].desc}</p>
						<div class="fam-tags">
							<span class="fam-tag fam-tag-indigo">{TSHIRTS.length} références</span>
							<span class="fam-tag">Dès {prixTShirt.toFixed(2).replace('.', ',')} € / pièce</span>
						</div>
						<a class="fam-link" href="/produits/t-shirts">Parcourir les t-shirts</a>
					</div>
					<a class="fam-card fam-card-soon" href="/produits/t-shirts">
						<div>
							<div class="fam-eyebrow">Famille 02</div>
							<h3>Sweats</h3>
							<p>{familles[1].desc}</p>
						</div>
						<span class="fam-tag">Bientôt</span>
					</a>
				</div>
				<div class="fam-grid fam-grid-small">
					{familles.slice(2).map((f, i) => (
						<div class="fam-card fam-card-mini">
							<div class="fam-eyebrow">Famille {String(i + 3).padStart(2, '0')}</div>
							<h3>{LABELS_TYPE_TEXTILE[f.type]}</h3>
							<p>{f.desc}</p>
							<span class="fam-tag">Bientôt</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="phome-section">
			<div class="wrap">
				<div class="phome-section-head">
					<h2>Les prix les plus bas</h2>
					<a class="phome-section-link" href="/produits/t-shirts">Tout le catalogue, avec filtres →</a>
				</div>
				<div class="bs-grid">
					{bestSellers.map((t) => {
						const prix = prixAPartirDe(t.baseCost);
						return (
							<a class="bs-card" href={`/produits/t-shirts/${t.slug}`}>
								<div class="bs-brand">{t.brand}</div>
								<h3>{t.model}</h3>
								<div class="fam-tags">
									<span class="fam-tag">{t.grammage}</span>
									<span class="fam-tag">{LABELS_GENRE[t.genre]}</span>
								</div>
								<div class="bs-price">
									<span>dès {PALIERS_TARIF[0].min} pièce{PALIERS_TARIF[0].min > 1 ? 's' : ''}</span>
									<span class="bs-price-val"><b>{prix.toFixed(2).replace('.', ',')} €</b><em>/ pièce</em></span>
								</div>
							</a>
						);
					})}
				</div>
				<p class="phome-footnote">Prix unitaires hors marquage, au palier {PALIERS_TARIF[0].label} pièces. La grille complète est affichée sur chaque fiche produit.</p>
			</div>
		</section>

		<section class="phome-band phome-band-indigo">
			<div class="wrap phome-band-grid">
				<div>
					<h2>Chaque base ne va pas avec chaque technique</h2>
					<p>Le grammage et la matière décident du rendu. Le configurateur applique ces règles pour vous, mais voici la logique.</p>
					<a class="btn btn-light" href="/techniques">Comparer les techniques</a>
				</div>
				<div class="phome-tech-list">
					<a class="phome-tech-card" href="/techniques/serigraphie">
						<h3>Sérigraphie</h3>
						<p>Aplats francs sur coton, dès {seuils.quantitePiecesSerigraphie} pièces. Le coût par pièce chute vite avec la quantité.</p>
					</a>
					<a class="phome-tech-card" href="/techniques/transfert-quadrichromie">
						<h3>Transfert</h3>
						<p>Photos et dégradés, sans minimum de série. Idéal pour les petites quantités et les visuels détaillés.</p>
					</a>
					<a class="phome-tech-card" href="/techniques/broderie">
						<h3>Broderie</h3>
						<p>Fil sur polos, sweats et casquettes, dès {seuils.quantitePiecesBroderie} pièces. Rendu durable, sans limite de lavages.</p>
					</a>
				</div>
			</div>
		</section>

		<section class="phome-section">
			<div class="wrap">
				<div class="phome-section-head">
					<h2>Le prix baisse par palier</h2>
					<span class="phome-section-note">Grille provisoire, en cours de validation fournisseur.</span>
				</div>
				<div class="palier-grid">
					{PALIERS_TARIF.map((p) => (
						<div class="palier-card">
							<div class="palier-num">{p.label}</div>
							<div class="palier-label">pièces</div>
							<div class="palier-bar"><div style={`width:${barWidth(p.marge)}%`} /></div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="phome-band phome-band-jaune">
			<div class="wrap phome-band-flex">
				<div>
					<h2>Un doute sur la base à choisir ?</h2>
					<p>Envoyez votre visuel et votre quantité : on vous répond avec une recommandation de textile, un devis et un bon à tirer avant lancement.</p>
				</div>
				<div class="phome-hero-cta">
					<a class="btn" href="/#commander">Demander un devis</a>
					<a class="btn btn-light" href="/simulateur">Estimer au simulateur</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
