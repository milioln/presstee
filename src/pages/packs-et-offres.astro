---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TSHIRTS } from '../data/tshirts';
import { grilleTarifaire } from '../config/tarification';
import '../styles/global.css';
import '../styles/techniques.css';

// Exemple pris sur la référence la moins chère du catalogue, pour
// illustrer la baisse de prix par palier — pas de marge affichée : ce
// chiffre-là reste interne (cf. config/tarification.ts).
const exemple = TSHIRTS.reduce((min, t) => (t.baseCost < min.baseCost ? t : min), TSHIRTS[0]);
const grille = grilleTarifaire(exemple.baseCost);
---

<Layout title="Packs et offres — Presstee" description="Pas de catalogue de packs figés : chaque projet est chiffré sur mesure, avec une grille de prix dégressive selon la quantité commandée.">
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Packs et offres</div>
				<h1>Pas de pack figé, un prix qui baisse avec la quantité.</h1>
				<p>Presstee ne vend pas de formules toutes faites : chaque commande est chiffrée sur mesure, selon votre vêtement, votre technique de marquage et votre quantité. En revanche, plus vous commandez, moins le prix à la pièce est élevé — la grille dégressive est la même pour tout le monde, visible sur chaque fiche produit.</p>
				<a class="btn" href="/commencer">Estimer mon projet</a>
			</div>
		</section>

		<section class="packs-body">
			<div class="wrap">
				<h2>La grille dégressive, en exemple</h2>
				<p class="packs-note">Sur {exemple.brand} {exemple.model} (textile seul, hors marquage) — chaque référence a sa propre grille, visible sur sa fiche produit.</p>
				<div class="packs-table">
					{grille.map((p) => (
						<div class="packs-row">
							<span class="packs-label">{p.label} pièces</span>
							<span class="packs-marge">{p.prixUnitaire.toFixed(2).replace('.', ',')} € / pièce</span>
						</div>
					))}
				</div>
				<p class="packs-cta-note">Pour connaître le prix exact de votre projet, passez par <a href="/commencer">le test guidé</a> ou <a href="/contact">demandez-nous directement</a>.</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.packs-body {
		padding: 44px 0 90px;
		max-width: 640px;
		margin: 0 auto;
	}
	.packs-body h2 {
		font-size: 1.15rem;
		margin-bottom: 8px;
	}
	.packs-note {
		color: var(--gris);
		font-size: 14px;
		margin-bottom: 20px;
	}
	.packs-table {
		border: 1.5px solid var(--ligne);
		border-radius: 14px;
		overflow: hidden;
	}
	.packs-row {
		display: flex;
		justify-content: space-between;
		padding: 14px 20px;
		border-bottom: 1px solid var(--ligne);
		font-size: 14.5px;
	}
	.packs-row:last-child {
		border-bottom: none;
	}
	.packs-label {
		font-weight: 600;
	}
	.packs-marge {
		color: var(--gris);
	}
	.packs-cta-note {
		color: var(--gris);
		margin-top: 24px;
	}
	.packs-cta-note a {
		color: var(--indigo);
	}
</style>
