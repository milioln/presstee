---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParcoursBar from '../components/ParcoursBar.astro';
import '../styles/global.css';
import '../styles/techniques.css';
import '../styles/panier.css';
---

<Layout title="Votre panier — Presstee" description="Retrouvez les projets ajoutés depuis le configurateur, ajustez-les et demandez un devis groupé.">
	<Header />
	<ParcoursBar step={3} />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Panier</div>
				<h1>Votre panier.</h1>
				<p>Les projets composés dans le configurateur, prêts pour un devis groupé. Rien n'est enregistré côté serveur : tout reste dans ce navigateur.</p>
			</div>
		</section>

		<div class="wrap">
			<h2 class="sr-only">Votre panier</h2>
			<div class="panierLayout" id="panierLayout">
				<div class="panierEmpty" id="panierEmpty">
					<h3>Votre panier est vide.</h3>
					<p>Composez un projet dans le configurateur, puis ajoutez-le au panier pour le retrouver ici avant de demander un devis.</p>
					<a class="btn" href="/personnaliser">Créer un projet</a>
				</div>

				<div class="panierItems" id="panierItems" style="display:none"></div>

				<aside class="side-card panierSummary" id="panierSummary" style="display:none">
					<h3>Récapitulatif</h3>
					<div class="panierSummaryLine"><span id="sumCount"></span><span id="sumQty"></span></div>
					<div class="panierSummaryTotal" id="sumTotal"></div>
					<button class="btn" id="sendCart">Demander un devis pour tout le panier</button>
					<a class="mini-btn" href="/bon-a-tirer" style="display:block;margin-top:10px">Voir l'aperçu du bon à tirer →</a>
					<button type="button" class="clearBtn" id="clearCart">Vider le panier</button>
					<p class="hint">Réponse sous 24 h ouvrées · estimation indicative, devis définitif à la confirmation.</p>
				</aside>
			</div>
		</div>
	</main>
	<Footer />

	<script>
		import { getCart, removeFromCart, clearCart, briefForCart, visuelsForCart, savedItemQty, type SavedItem } from '../scripts/personnalisateur/cart';
		import { setDemandeBrief } from '../lib/demande-brief';
		import { seedFromItem } from '../scripts/personnalisateur/state';
		import { GARMENTS } from '../scripts/personnalisateur/garments';
		import { PLACE_LABEL, type TailleCode } from '../config/parametres-metier';
		import type { Layer } from '../scripts/personnalisateur/state';

		function el<T extends HTMLElement = HTMLElement>(id: string): T {
			return document.getElementById(id) as T;
		}

		function fmtPrice(n: number): string {
			return `${n.toFixed(2).replace('.', ',')} €`;
		}

		function fmtDate(ts: number): string {
			return new Date(ts).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
		}

		function delaiLabel(d: SavedItem['delai']): string {
			return d === 'express' ? 'Express (5 jours ouvrés)' : 'Standard (10 jours ouvrés)';
		}

		function sizesLabel(sizeDist: Record<TailleCode, number>): string {
			const parts = Object.entries(sizeDist)
				.filter(([, n]) => (n as number) > 0)
				.map(([t, n]) => `${t} ×${n}`);
			return parts.length ? parts.join(', ') : 'tailles non renseignées';
		}

		// Le configurateur n'a aujourd'hui qu'une seule technique par
		// projet (pas encore une par emplacement) : chaque calque déposé
		// est affiché comme sa propre ligne de marquage sous la même
		// technique, avec le prix total réparti à parts égales entre les
		// marquages — une répartition d'affichage, pas un vrai calcul de
		// coût individuel (le modèle de prix ne descend pas à ce niveau
		// de détail pour l'instant).
		function markLine(it: SavedItem, layer: Layer): string {
			const thumb = layer.img ? `<img src="${layer.img}" alt="" />` : '';
			const price = it.layers.length ? it.prixTotal / it.layers.length : it.prixTotal;
			return `<div class="panierMark">
				<div class="panierMark-thumb">${thumb}</div>
				<span class="panierMark-label">${it.techNom} · ${PLACE_LABEL[layer.place]} · ${layer.colors ?? 1} couleur${(layer.colors ?? 1) > 1 ? 's' : ''}</span>
				<span class="panierMark-price">${fmtPrice(price)}</span>
			</div>`;
		}

		function designHelpLine(it: SavedItem): string {
			const dh = it.designHelp;
			const colorsLabel = dh.colors == null ? null : dh.colors >= 12 ? '12 et plus / dégradé' : `${dh.colors} couleur${dh.colors > 1 ? 's' : ''}`;
			const parts = [colorsLabel, dh.format || null].filter((p): p is string => !!p);
			const detail = parts.length ? parts.join(' · ') : null;
			return `<p class="panierMark-empty">Pas de visuel déposé — accompagnement design demandé${detail ? ` (${detail})` : ''}.${dh.notes ? ` « ${dh.notes} »` : ''}</p>`;
		}

		// Clin d'œil : signale deux projets strictement identiques dans le
		// panier plutôt que de les fusionner ou les bloquer silencieusement
		// — souvent voulu (une même pièce pour deux coloris de calendrier
		// différent), donc juste une note amicale, jamais un blocage (Milio,
		// 2026-09-09, menu d'easter eggs validé).
		function itemSignature(it: SavedItem): string {
			const lots = it.colorLots.map((l) => `${l.color.hex}:${JSON.stringify(l.sizeDist)}`).sort().join(',');
			return [it.garment, lots, it.techNom, it.layers.map((l) => l.place).sort().join(',')].join('|');
		}

		// Un ou plusieurs coloris par article, chacun avec sa propre
		// répartition de tailles (Milio, 2026-09-09).
		function colorLotsLine(it: SavedItem): string {
			if (it.colorLots.length === 1) {
				const lot = it.colorLots[0];
				return `${lot.color.nom} · ${sizesLabel(lot.sizeDist)} (${savedItemQty(it)} pièce${savedItemQty(it) > 1 ? 's' : ''})`;
			}
			return it.colorLots
				.map((lot) => {
					const qty = Object.values(lot.sizeDist).reduce((s, n) => s + n, 0);
					return `${lot.color.nom} : ${sizesLabel(lot.sizeDist)} (${qty})`;
				})
				.join(' · ');
		}

		function itemCard(it: SavedItem, isDuplicate: boolean): string {
			const garmentName = GARMENTS[it.garment].name;
			const marks = it.layers.length ? it.layers.map((l) => markLine(it, l)).join('') : designHelpLine(it);
			return `<div class="panierItem" data-id="${it.id}">
				<div class="panierItem-head">
					<div class="panierItem-thumb" style="background:${it.colorLots[0].color.hex}"></div>
					<div class="panierItem-headInfo">
						<h3>${garmentName}</h3>
						<p class="panierItem-meta">${colorLotsLine(it)}</p>
						<p class="panierItem-meta muted">${delaiLabel(it.delai)} · ajouté le ${fmtDate(it.savedAt)}</p>
					</div>
					<div class="panierItem-price">${fmtPrice(it.prixTotal)}</div>
				</div>
				<div class="panierItem-marks">${marks}</div>
				${isDuplicate ? `<p class="panierItem-dup">Vous avez ajouté deux fois le même projet, c'est voulu ?</p>` : ''}
				<div class="panierItem-actions">
					<button type="button" class="linkBtn" data-edit="${it.id}">Modifier</button>
					<button type="button" class="linkBtn danger" data-rm="${it.id}">Retirer</button>
				</div>
			</div>`;
		}

		function render(): void {
			const items = getCart();
			const empty = el('panierEmpty');
			const itemsWrap = el('panierItems');
			const summary = el('panierSummary');

			if (!items.length) {
				empty.style.display = 'block';
				itemsWrap.style.display = 'none';
				summary.style.display = 'none';
				return;
			}
			empty.style.display = 'none';
			itemsWrap.style.display = 'flex';
			summary.style.display = 'flex';
			const signatureCounts = new Map<string, number>();
			items.forEach((it) => {
				const sig = itemSignature(it);
				signatureCounts.set(sig, (signatureCounts.get(sig) ?? 0) + 1);
			});
			itemsWrap.innerHTML = items.map((it) => itemCard(it, (signatureCounts.get(itemSignature(it)) ?? 0) > 1)).join('');

			const totalQty = items.reduce((s, it) => s + savedItemQty(it), 0);
			const totalPrice = items.reduce((s, it) => s + it.prixTotal, 0);
			el('sumCount').textContent = `${items.length} projet${items.length > 1 ? 's' : ''}`;
			el('sumQty').textContent = `${totalQty} pièce${totalQty > 1 ? 's' : ''} au total`;
			el('sumTotal').textContent = fmtPrice(totalPrice);
		}

		el('panierItems').addEventListener('click', (e) => {
			const rm = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rm]');
			if (rm) {
				removeFromCart(rm.dataset.rm!);
				render();
				return;
			}
			const edit = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-edit]');
			if (edit) {
				const item = getCart().find((i) => i.id === edit.dataset.edit);
				if (item) {
					seedFromItem(item);
					window.location.href = '/personnaliser';
				}
			}
		});

		el('sendCart').addEventListener('click', () => {
			setDemandeBrief(briefForCart(), visuelsForCart());
			window.location.href = '/demande-devis';
		});
		el('clearCart').addEventListener('click', () => {
			if (!window.confirm('Vider le panier ?')) return;
			clearCart();
			render();
		});

		render();
	</script>
</Layout>
