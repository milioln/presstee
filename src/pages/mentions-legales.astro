---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';
import '../styles/techniques.css';
---

<Layout title="Mentions légales — Presstee" description="Mentions légales de presstee.fr." noindex>
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Mentions légales</div>
				<h1>Mentions légales.</h1>
			</div>
		</section>

		<section class="legal-body">
			<div class="wrap">
				<div class="legal-notice">
					<p><strong>Ce site est en cours de constitution juridique.</strong> {siteConfig.nom} n'est pas encore immatriculé (numéro SIRET à venir) : les mentions légales complètes — forme juridique, capital, numéro d'immatriculation, hébergeur — seront publiées ici dès l'immatriculation de la structure.</p>
				</div>
				<div class="legal-known">
					<h2>Ce qui est déjà connu</h2>
					<div class="legal-row"><b>Nom commercial</b><span>{siteConfig.nom}</span></div>
					<div class="legal-row"><b>Activité</b><span>Personnalisation textile (sérigraphie, broderie, transfert)</span></div>
					<div class="legal-row"><b>Atelier</b><span>{siteConfig.adresse.ville}, {siteConfig.adresse.departement}</span></div>
					<div class="legal-row"><b>Contact</b><span>{siteConfig.email}</span></div>
				</div>
				<p class="legal-footer-note">Une question en attendant ? <a href="/contact">Contactez-nous</a>.</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.legal-body {
		padding: 44px 0 90px;
		max-width: 640px;
		margin: 0 auto;
	}
	.legal-notice {
		background: var(--lavande);
		border-radius: 14px;
		padding: 20px 22px;
		margin-bottom: 32px;
	}
	.legal-notice p {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.6;
	}
	.legal-known h2 {
		font-size: 1.05rem;
		margin-bottom: 14px;
	}
	.legal-row {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 12px 0;
		border-bottom: 1px solid var(--ligne);
		font-size: 14.5px;
	}
	.legal-row b {
		flex-shrink: 0;
	}
	.legal-row span {
		color: var(--gris);
		text-align: right;
	}
	.legal-footer-note {
		margin-top: 28px;
		color: var(--gris);
		font-size: 14px;
	}
	.legal-footer-note a {
		color: var(--indigo);
	}
</style>
