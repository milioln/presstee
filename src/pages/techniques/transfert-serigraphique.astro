---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { TECHNIQUES, getTechnique } from '../../lib/techniques-data';
import '../../styles/global.css';
import '../../styles/techniques.css';

const t = getTechnique('transfert-serigraphique')!;
const autres = TECHNIQUES.filter((x) => x.slug !== t.slug);
---

<Layout title="Le transfert sérigraphique — Presstee" description="Comment fonctionne le transfert sérigraphique, un entre-deux entre sérigraphie et transfert : avantages, limites, et calcul du prix.">
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / <a href="/techniques">Guide</a> / Transfert sérigraphique</div>
				<h1>Le transfert sérigraphique.</h1>
				<p>Le rendu de la sérigraphie, sans le calage direct sur la pièce : le visuel est sérigraphié sur un support, puis transféré à chaud.</p>
			</div>
		</section>

		<div class="tdetail-hero noimg">
			<svg viewBox="0 0 24 24" fill="none" stroke="var(--indigo)" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h5"/><path d="M15 16l2 2 4-4"/></svg>
		</div>

		<div class="wrap">
			<div class="tdetail">
				<div>
					<section>
						<h2>Comment ça marche</h2>
						<p class="lede">Le principe de la sérigraphie reste le même — un écran par couleur, de l'encre poussée à la raclette — mais l'impression se fait sur un support intermédiaire plutôt que directement sur le vêtement. Ce support est ensuite posé à chaud sur la pièce, comme un transfert.</p>
						<div class="steps-list">
							<div class="step"><span class="n">1</span><div><strong>La sérigraphie sur support</strong><span>Le visuel est imprimé, écran par écran, sur un film support plutôt que sur le textile.</span></div></div>
							<div class="step"><span class="n">2</span><div><strong>Le détourage</strong><span>Le support est découpé aux contours du visuel.</span></div></div>
							<div class="step"><span class="n">3</span><div><strong>La pose à chaud</strong><span>Le transfert est positionné et pressé sur chaque pièce individuellement.</span></div></div>
						</div>
					</section>

					<section>
						<h2>Avantages et limites</h2>
						<div class="proscons">
							<div class="col avantages">
								<h4>✓ Avantages</h4>
								<ul>
									<li>Un rendu très proche de la sérigraphie directe, y compris la tenue au lavage</li>
									<li>Pas de calage individuel sur chaque pièce : utile sur des emplacements difficiles d'accès (manches, capuches) ou des textiles techniques</li>
									<li>Les transferts peuvent être préparés à l'avance et posés au fur et à mesure</li>
								</ul>
							</div>
							<div class="col limites">
								<h4>⚠ Points de vigilance</h4>
								<ul>
									<li>Toujours limité en nombre de couleurs, comme la sérigraphie classique</li>
									<li>Une étape supplémentaire (impression puis pose) par rapport à la sérigraphie directe</li>
									<li>Sur de très gros volumes, la sérigraphie directe reste généralement plus économique</li>
								</ul>
							</div>
						</div>
					</section>

					<section>
						<h2>Comment se calcule le prix</h2>
						<p class="lede">Comme pour la sérigraphie directe, <strong>le prix dépend du nombre de couleurs</strong> du visuel — chaque couleur reste un écran à préparer. La différence se joue sur la quantité : sans calage direct sur chaque pièce, cette technique reste intéressante sur des séries plus petites que la sérigraphie classique.</p>
					</section>
				</div>

				<aside>
					<div class="side-card">
						<h4>Pour quel projet</h4>
						<p>{t.quantiteMin.toLowerCase()}. {t.couleurs}. Utile sur les textiles techniques ou les emplacements difficiles à sérigraphier directement.</p>
					</div>
					<div class="side-card">
						<h4>Le prix dépend de</h4>
						<div class="big">{t.facteurPrix}</div>
					</div>
					<div class="side-card">
						<h4>Durabilité</h4>
						<p>{t.durabilite}.</p>
					</div>
					<Button href="/personnalisateur?technique=transfert-serigraphique">Personnaliser en transfert sérigraphique</Button>
				</aside>
			</div>

			<div class="other-techs-wrap">
				<h3 class="other-techs-title">Les autres techniques</h3>
				<div class="other-techs">
					{autres.map((a) => <a href={`/techniques/${a.slug}`}>{a.nom}</a>)}
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
