---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import TechMiniReco from '../../components/TechMiniReco.astro';
import { TECHNIQUES, getTechnique } from '../../lib/techniques-data';
import '../../styles/global.css';
import '../../styles/techniques.css';

const t = getTechnique('transfert-quadrichromie')!;
const autres = TECHNIQUES.filter((x) => x.slug !== t.slug);
---

<Layout title="Le transfert quadrichromie — Presstee" description="Comment fonctionne le transfert quadrichromie (impression numérique CMJN + pose à chaud), ses avantages, ses limites, et comment son prix se calcule selon le format du visuel.">
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / <a href="/techniques">Guide</a> / Transfert quadrichromie</div>
				<h1>Le transfert quadrichromie.</h1>
				<p>Un visuel imprimé numériquement en quadrichromie (CMJN) puis posé à chaud : couleurs illimitées, dégradés, photos — sans minimum de quantité.</p>
			</div>
		</section>

		<div class="tdetail-hero">
			<img src={t.image} alt="Impression DTF du logo Presstee en quadrichromie, prête à être posée à chaud sur un t-shirt" loading="eager" />
		</div>

		<div class="wrap">
			<div class="tdetail">
				<div>
					<section>
						<h2>Comment ça marche</h2>
						<p class="lede">Votre visuel est imprimé numériquement en quadrichromie (cyan, magenta, jaune, noir) sur un support de transfert. Ce support est ensuite posé sur le vêtement et pressé à chaud : la chaleur et la pression font adhérer le visuel au tissu.</p>
						<div class="steps-list">
							<div class="step"><span class="n">1</span><div><strong>L'impression numérique</strong><span>Votre fichier est imprimé en quadrichromie, couleurs et dégradés compris, sur un film de transfert.</span><img class="step-photo" src="/techniques/etapes/quadrichromie-1-impression-numerique.jpg" alt="Impression numérique du logo Presstee en quadrichromie sur film de transfert" loading="lazy" /></div></div>
							<div class="step"><span class="n">2</span><div><strong>Le détourage</strong><span>Le contour du visuel est découpé pour ne laisser que la zone à transférer.</span><img class="step-photo" src="/techniques/etapes/quadrichromie-2-detourage.jpg" alt="Détourage aux ciseaux d'un visuel imprimé sur film de transfert" loading="lazy" /></div></div>
							<div class="step"><span class="n">3</span><div><strong>La pose à chaud</strong><span>Le film est positionné sur le vêtement et pressé à haute température pendant quelques secondes.</span><img class="step-photo" src="/techniques/etapes/quadrichromie-3-pose-a-chaud.jpg" alt="Presse à chaud posant un transfert quadrichromie sur un t-shirt" loading="lazy" /></div></div>
							<div class="step"><span class="n">4</span><div><strong>Le pelage</strong><span>Le film support est retiré, ne laissant que le visuel sur le tissu.</span><img class="step-photo" src="/techniques/etapes/quadrichromie-4-pelage.jpg" alt="Film support retiré après pose d'un transfert quadrichromie sur un t-shirt" loading="lazy" /></div></div>
						</div>
					</section>

					<section>
						<h2>Avantages et limites</h2>
						<div class="proscons">
							<div class="col avantages">
								<h3>✓ Avantages</h3>
								<ul>
									<li>Aucune limite de couleurs : dégradés, photos et visuels complexes sont reproduits fidèlement</li>
									<li>Aucun frais de calage : rentable dès une seule pièce</li>
									<li>Chaque pièce peut porter un visuel différent, sans surcoût de changement</li>
								</ul>
							</div>
							<div class="col limites">
								<h3>⚠ Points de vigilance</h3>
								<ul>
									<li>Le visuel repose en surface du tissu, avec un léger relief au toucher</li>
									<li>Sur de grandes séries identiques, la sérigraphie reste plus économique</li>
									<li>Moins adapté aux textiles très extensibles, qui peuvent faire craqueler le transfert dans le temps</li>
								</ul>
							</div>
						</div>
					</section>

					<section>
						<h2>Comment se calcule le prix</h2>
						<p class="lede">Contrairement à la sérigraphie, <strong>le prix du transfert quadrichromie dépend de la taille du visuel</strong>, pas de son nombre de couleurs — l'impression en quadrichromie reproduit n'importe quelle palette pour le même coût. Plus le visuel est grand, plus il consomme de support d'impression et plus le temps de pose est long.</p>
						<p class="lede">Sans frais de calage, cette technique reste au même prix par pièce quelle que soit la quantité commandée : c'est le choix le plus simple pour une petite série ou un visuel unique par personne.</p>
					</section>
				</div>

				<aside>
					<div class="side-card">
						<h3>Pour quel projet</h3>
						<p>{t.quantiteMin.toLowerCase()}. {t.couleurs}. Idéal pour un visuel riche en couleurs ou une personnalisation individuelle.</p>
					</div>
					<div class="side-card">
						<h3>Le prix dépend de</h3>
						<div class="big">{t.facteurPrix}</div>
					</div>
					<div class="side-card">
						<h3>Durabilité</h3>
						<p>{t.durabilite}.</p>
					</div>
					<TechMiniReco tech={t.slug} />
					<Button href="/personnaliser?technique=transfert-quadrichromie">Personnaliser en transfert quadrichromie</Button>
				</aside>
			</div>

			<div class="other-techs-wrap">
				<h3 class="other-techs-title">Les autres techniques</h3>
				<div class="other-techs">
					{autres.map((a) => <a href={`/techniques/${a.slug}`}>{a.nom}</a>)}
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	import { initStepPhotoReveal } from '../../scripts/step-photo-reveal';
	initStepPhotoReveal();
</script>
