---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TECHNIQUES } from '../../lib/techniques-data';
import { SECTEURS } from '../../data/secteurs';
import '../../styles/global.css';
import '../../styles/techniques.css';

// Libellés courts des tampons — un simple découpage à 2 lettres tombait
// parfois sans aucun sens ("BD" pour BDE, "BA" pour Bars et restaurants)
// (Milio, 2026-09-15). Un mot ou une abréviation choisis à la main par
// entrée plutôt qu'une règle automatique.
const SECTEUR_STAMP: Record<string, string> = {
	associations: 'Asso',
	'bde-ecoles': 'BDE',
	'bars-restaurants': 'Bar',
};
// "Marques de vêtements" et "Événements" ont droit à un petit dessin
// plutôt qu'un mot (Milio, 2026-09-15 : « ne mets pas Marque, mets-moi
// un t-shirt » ; 2026-09-16 : « la petite case avec marqué É-V-É-N...
// quelque chose de plus sympa ») — les autres secteurs gardent leur
// tampon texte.
const SECTEUR_ICON: Record<string, string> = {
	'marques-de-vetements':
		'<path d="M8 3L3 7l3 3 2-1.5V20a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V8.5l2 1.5 3-3-5-4-2 2h-2z"/>',
	evenements:
		'<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M16 2.5v4M8 2.5v4M3 10h18"/><circle cx="9" cy="14.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="13.5" cy="14.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="9" cy="18" r="1.3" fill="currentColor" stroke="none"/>',
};
// Petits dessins très simples plutôt que des initiales (Milio,
// 2026-09-15 : « Sérig, Quadri, Mono... ça passe à côté de l'intérêt,
// je voudrais un petit dessin ») : le carrousel de sérigraphie, une
// presse avec les points de couleur du CMJN pour la quadrichromie (un
// seul point pour le monochrome), un cercle à broder pour la broderie.
// Les 4 écrans du carrousel de sérigraphie sont colorés différemment
// (Milio, 2026-09-15 : « mets-moi une couleur pour chaque écran... on
// comprend mieux ») plutôt qu'en une seule couleur uniforme.
const TECHNIQUE_ICON: Record<string, string> = {
	serigraphie:
		'<circle cx="12" cy="12" r="2.6"/><rect x="10" y="1.5" width="4" height="4.5" rx="1" fill="#9B07FF" stroke="none"/><rect x="10" y="18" width="4" height="4.5" rx="1" fill="#FFC500" stroke="none"/><rect x="1.5" y="10" width="4.5" height="4" rx="1" fill="#2EC4B6" stroke="none"/><rect x="18" y="10" width="4.5" height="4" rx="1" fill="#F25C54" stroke="none"/>',
	'transfert-quadrichromie':
		'<rect x="4" y="2.5" width="16" height="5" rx="1.5"/><circle cx="8" cy="15" r="1.7" fill="#00AEEF" stroke="none"/><circle cx="16" cy="15" r="1.7" fill="#EC008C" stroke="none"/><circle cx="8" cy="20" r="1.7" fill="#FFE000" stroke="none"/><circle cx="16" cy="20" r="1.7" fill="#17131F" stroke="none"/>',
	'transfert-monochrome':
		'<rect x="4" y="2.5" width="16" height="5" rx="1.5"/><circle cx="12" cy="16.5" r="2.2" fill="currentColor" stroke="none"/>',
	broderie: '<path d="M12 2v6.5"/><circle cx="12" cy="10" r="1.3" fill="currentColor" stroke="none"/><path d="M2.5 16c2.3-3 4.7-3 7 0s4.7 3 7 0s3-3 5-2.2"/>',
};
---

<Layout title="Guide des techniques de marquage — Presstee" description="Sérigraphie, transfert monochrome, transfert quadrichromie, broderie : comment ça marche, avantages, limites et comment le prix se calcule pour chaque technique.">
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Guide</div>
				<h1>Bien choisir sa technique de marquage.</h1>
				<p>Sérigraphie, transfert ou broderie : chacune a ses forces, ses limites et sa propre façon de calculer le prix. Comparez-les ci-dessous.</p>
			</div>
		</section>

		<div class="wrap">
			<h2 class="sr-only">Les techniques</h2>
			<div class="tgrid" style="margin-top:44px">
				{TECHNIQUES.map((t) => (
					<a class="tcard" href={`/techniques/${t.slug}`}>
						<div class="tcard-photo">
							{t.image && <img class="tcard-bg" src={t.image} alt="" aria-hidden="true" loading="lazy" />}
							<span class="techsect-stamp" aria-hidden="true">
								<span
									class="techsect-stamp-icon"
									set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:26px;height:26px">${TECHNIQUE_ICON[t.slug] ?? ''}</svg>`}
								/>
							</span>
						</div>
						<div class="body">
							<h3>{t.nom}</h3>
							<p>{t.accroche}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Même présentation, même alignement et même échelle que le
			     hero de la page (Milio, 2026-09-15 : « exactement la même
			     forme que bien choisir sa technique de marquage ») — vrai
			     H1 (Milio : « je veux que ça soit vraiment en H1 ») plutôt
			     qu'un H2 simplement stylé pareil. -->
			<div class="techIntro" style="margin-top:60px">
				<h1 class="likeH1">Des conseils selon votre activité.</h1>
				<p>Association, restaurant, événement, marque de vêtements... chaque secteur a ses contraintes et ses habitudes de commande.</p>
			</div>
			<div class="tgrid tgrid-3col" style="margin-top:44px">
				{SECTEURS.map((s) => (
					<a class="tcard" href={`/secteurs/${s.slug}`}>
						<div class="tcard-photo">
							{s.image && <img class="tcard-bg" src={s.image} alt="" aria-hidden="true" loading="lazy" />}
							<span class="techsect-stamp" aria-hidden="true">
								{SECTEUR_ICON[s.slug] ? (
									<span
										class="techsect-stamp-icon"
										set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:26px;height:26px">${SECTEUR_ICON[s.slug]}</svg>`}
									/>
								) : (
									<span class="techsect-stamp-mono">{SECTEUR_STAMP[s.slug] ?? s.nom.slice(0, 2)}</span>
								)}
							</span>
						</div>
						<div class="body">
							<h3>{s.nom}</h3>
							<p>{s.accroche}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Tableau ramené tout en bas de page (Milio, 2026-09-15 :
			     « finalement, mets le tableau en bas de la page ») — après
			     un essai juste sous les 4 techniques, jugé pas assez lisible
			     par-dessus le reste. Rendu plus facile au doigt (même
			     demande) : première colonne collée à l'écran pendant le
			     défilement horizontal, et un repère "faites glisser"
			     visible seulement sur mobile. -->
			<div class="tcompare">
				<h2 class="sr-only">Tableau comparatif des techniques</h2>
				<p class="tcompare-hint">Faites glisser pour comparer →</p>
				<table>
					<thead>
						<tr>
							<th></th>
							{TECHNIQUES.map((t) => <th><a href={`/techniques/${t.slug}`}>{t.nom}</a></th>)}
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">Quantité conseillée</th>
							{TECHNIQUES.map((t) => <td>{t.quantiteMin}</td>)}
						</tr>
						<tr>
							<th scope="row">Couleurs</th>
							{TECHNIQUES.map((t) => <td>{t.couleurs}</td>)}
						</tr>
						<tr>
							<th scope="row">Le prix dépend de</th>
							{TECHNIQUES.map((t) => <td>{t.facteurPrix}</td>)}
						</tr>
						<tr>
							<th scope="row">Coût relatif</th>
							{TECHNIQUES.map((t) => (
								<td>
									<span class="prixdots">
										{[1, 2, 3].map((i) => <span class={i <= t.prixRelatif ? 'on' : ''}></span>)}
									</span>
								</td>
							))}
						</tr>
						<tr>
							<th scope="row">Durabilité</th>
							{TECHNIQUES.map((t) => <td>{t.durabilite}</td>)}
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
