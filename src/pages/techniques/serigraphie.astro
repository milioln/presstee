---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { TECHNIQUES, getTechnique } from '../../lib/techniques-data';
import '../../styles/global.css';
import '../../styles/techniques.css';

const t = getTechnique('serigraphie')!;
const autres = TECHNIQUES.filter((x) => x.slug !== t.slug);
---

<Layout title="La sérigraphie textile — Presstee" description="Comment fonctionne la sérigraphie textile, ses avantages, ses limites, et comment son prix se calcule selon le nombre de couleurs et la quantité.">
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / <a href="/techniques">Guide</a> / Sérigraphie</div>
				<h1>La sérigraphie.</h1>
				<p>La technique la plus ancienne du marquage textile, et souvent la plus économique dès qu'on dépasse quelques dizaines de pièces.</p>
			</div>
		</section>

		<div class="tdetail-hero">
			<img src={t.image} alt="Atelier de sérigraphie textile Presstee : écrans et t-shirts en cours d'impression" loading="eager" />
		</div>

		<div class="wrap">
			<div class="tdetail">
				<div>
					<section>
						<h2>Comment ça marche</h2>
						<p class="lede">Chaque couleur de votre visuel est isolée sur un écran (un cadre tendu d'une maille fine, bloquée partout sauf sur le dessin). Une raclette pousse l'encre à travers la maille ouverte, directement dans les fibres du textile.</p>
						<div class="steps-list">
							<div class="step"><span class="n">1</span><div><strong>Un écran par couleur</strong><span>Votre visuel est séparé en autant de calques que de couleurs, chacun gravé sur son propre écran.</span></div></div>
							<div class="step"><span class="n">2</span><div><strong>Le calage</strong><span>Chaque écran est positionné avec précision pour que les couleurs s'alignent parfaitement une fois superposées.</span></div></div>
							<div class="step"><span class="n">3</span><div><strong>L'impression</strong><span>La raclette pousse l'encre à travers chaque écran, couleur après couleur, sur chaque pièce de la série.</span></div></div>
							<div class="step"><span class="n">4</span><div><strong>Le séchage</strong><span>L'encre est fixée à la chaleur pour résister au lavage.</span></div></div>
						</div>
					</section>

					<section>
						<h2>Avantages et limites</h2>
						<div class="proscons">
							<div class="col avantages">
								<h4>✓ Avantages</h4>
								<ul>
									<li>Le rendu le plus dense, avec des couleurs vives et opaques même sur textile foncé</li>
									<li>L'encre est absorbée dans la fibre : très bonne tenue au lavage</li>
									<li>Le coût par pièce baisse fortement à partir de 25 exemplaires</li>
								</ul>
							</div>
							<div class="col limites">
								<h4>⚠ Points de vigilance</h4>
								<ul>
									<li>Un écran par couleur : les visuels très riches en nuances ou en dégradés ne sont pas adaptés</li>
									<li>Les frais de calage rendent la technique moins intéressante en très petite série</li>
									<li>Chaque changement de couleur sur le visuel nécessite un nouvel écran</li>
								</ul>
							</div>
						</div>
					</section>

					<section>
						<h2>Comment se calcule le prix</h2>
						<p class="lede">En sérigraphie, <strong>le prix dépend avant tout du nombre de couleurs</strong> de votre visuel, pas de sa taille : chaque couleur immobilise un écran, qu'il faut graver et caler avant de lancer la production. Une fois les écrans prêts, ils servent pour toute la série — plus la quantité est grande, plus ce coût de calage se répartit sur un grand nombre de pièces.</p>
						<p class="lede">C'est pour ça que la sérigraphie devient la technique la plus économique passé un certain volume : le calage est un coût fixe, l'impression elle-même coûte peu par pièce.</p>
					</section>
				</div>

				<aside>
					<div class="side-card">
						<h4>Pour quel projet</h4>
						<p>{t.quantiteMin.toLowerCase()}. Visuels en aplats, {t.couleurs.toLowerCase()}. Idéal pour une série identique portée régulièrement.</p>
					</div>
					<div class="side-card">
						<h4>Le prix dépend de</h4>
						<div class="big">{t.facteurPrix}</div>
					</div>
					<div class="side-card">
						<h4>Durabilité</h4>
						<p>{t.durabilite}.</p>
					</div>
					<Button href="/personnalisateur?technique=serigraphie">Personnaliser en sérigraphie</Button>
				</aside>
			</div>

			<div class="other-techs-wrap">
				<h3 class="other-techs-title">Les autres techniques</h3>
				<div class="other-techs">
					{autres.map((a) => <a href={`/techniques/${a.slug}`}>{a.nom}</a>)}
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
