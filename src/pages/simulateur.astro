---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/produits.css';
import '../styles/simulateur.css';
---

<Layout title="Simulateur de projet — Presstee" description="Estimez votre projet de personnalisation textile : plusieurs produits, plusieurs visuels par produit, une technique recommandée et un ordre de prix pour chacun.">
	<Header />
	<main>
		<section class="sim-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Simulateur</div>
				<h1>Chiffrez votre projet.</h1>
				<p>Ajoutez un ou plusieurs textiles, un ou plusieurs visuels par textile — avec ou sans fichier prêt. Nous recommandons la bonne technique et donnons un ordre de prix pour chacun, en temps réel.</p>
			</div>
		</section>

		<div class="wrap">
			<div class="sim-restore-note" id="simRestoreNote" style="display:none">
				Simulation précédente reprise sur cet appareil. <button type="button" class="linkBtn" id="simReset">Recommencer à zéro</button>
			</div>
			<div class="sim-layout">
				<div class="sim-main">
					<div id="produitsList" class="produitsList"></div>
					<button type="button" class="mini-btn mini-btn-lg" id="addProduit">+ Ajouter un autre produit</button>
				</div>

				<aside class="sim-side">
					<div class="side-card">
						<h4>Votre simulation</h4>
						<div class="sim-totals">
							<div class="sim-totals-row"><span id="simCount">1 produit</span></div>
							<div class="sim-totals-row"><span id="simQty">25 pièces au total</span></div>
							<div class="sim-totals-total"><span>Ordre de prix total</span><b id="simTotal">0 €</b></div>
						</div>
						<p class="sim-side-note">Cette estimation ne remplace pas un devis : le prix final dépend de votre visuel réel et peut être affiné avec nous.</p>
						<div class="sim-actions">
							<button type="button" class="btn" id="simCommander">Passer commande</button>
							<button type="button" class="btn btn-outline" id="simSauvegarder">Sauvegarder le projet</button>
							<button type="button" class="btn btn-outline" id="simAttente">Mettre en attente</button>
						</div>
						<p class="sim-side-note" id="simFeedback" style="display:none"></p>
						<a class="go" href="/configurateur">Personnaliser avec mon propre visuel →</a>
					</div>
					<div class="side-card">
						<h4>Besoin d'aide sur votre visuel ?</h4>
						<p>Pas encore de fichier ? Choisissez « Conseillez-moi » ou « En cours de création » sur un visuel : ça ne bloque rien, notre équipe vous accompagne ensuite.</p>
					</div>
				</aside>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	import { bindSimulateur } from '../scripts/simulateur';
	bindSimulateur();
</script>
