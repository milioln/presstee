---
// Une page dédiée par secteur d'activité, développée pour être trouvée
// depuis une recherche propre à ce secteur (« t-shirt personnalisé
// association », « polo brodé entreprise »…) et pour vraiment aider le
// visiteur à se décider et à commander — pas seulement une fiche
// technique (Milio, 2026-09-10 puis 2026-09-15 : « plus d'éléments
// graphiques, un meilleur article, un CTA qui ne prétend pas plus qu'il
// ne fait »). Contenu : src/data/secteurs.ts (source commune avec la
// liste de puces "Des conseils par activité" de l'accueil et du guide).
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SECTEURS } from '../../data/secteurs';
import { getTechnique } from '../../lib/techniques-data';
import { siteConfig } from '../../config/site';
import '../../styles/global.css';

export function getStaticPaths() {
	return SECTEURS.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: (typeof SECTEURS)[number] };
const technique = getTechnique(s.techniqueSlug)!;

// Une photo par secteur (Milio, 2026-09-16 : « t'as mis une bonne image
// pour les associations, fais pareil pour les autres ») — chacune choisie
// pour son secteur (libre de droits, sans marque tierce identifiable),
// pas une seule image générique réutilisée partout. Fichiers nommés
// `{slug}-hero(.webp|-mobile.webp)` dans public/secteurs/.
const HERO_ALT: Record<string, string> = {
	associations: 'Association sportive amateur en tenue personnalisée, vue de loin sur le terrain.',
	'bde-ecoles': 'Jeunes amis dansant lors d’une soirée étudiante.',
	'bars-restaurants': 'Serveur en tenue de salle accueillant un client en terrasse, à Paris.',
	evenements: 'Coureurs portant le même t-shirt numéroté lors d’un semi-marathon.',
	'marques-de-vetements': 'Deux mannequins portant des sweats à capuche floqués du logo d’une marque.',
};

const serviceLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	serviceType: 'Personnalisation textile',
	name: `Textile personnalisé pour ${s.nom.toLowerCase()}`,
	description: s.texte,
	url: `https://presstee.fr/secteurs/${s.slug}`,
	provider: { '@type': 'Organization', name: siteConfig.nom, url: 'https://presstee.fr' },
	areaServed: { '@type': 'Place', name: `${siteConfig.adresse.ville}, ${siteConfig.adresse.departement}` },
};
// Ces pages se trouvent depuis le Guide (grille "Des conseils selon
// votre activité"), pas depuis une page "Secteurs" qui n'existe pas
// (Milio, 2026-09-15 : « le fil d'Ariane n'est pas bon... on y accède
// par le guide ») — le fil d'Ariane, visible et structuré, doit suivre
// le même chemin que les fiches technique (Guide / Sérigraphie...).
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://presstee.fr/' },
		{ '@type': 'ListItem', position: 2, name: 'Guide', item: 'https://presstee.fr/techniques' },
		{ '@type': 'ListItem', position: 3, name: s.nom, item: `https://presstee.fr/secteurs/${s.slug}` },
	],
};
---

<Layout
	title={`Textile personnalisé pour ${s.nom.toLowerCase()} — Presstee`}
	description={`${s.texte} Technique conseillée : ${technique.nom.toLowerCase()}.`}
>
	<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
	<Header />
	<main>
		<section class="secteur-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / <a href="/techniques">Guide</a> / {s.nom}</div>
				<h1>Textile personnalisé pour {s.nom.toLowerCase()}.</h1>
				<p>{s.texte}</p>

				<div class="secteur-photo">
					<picture>
						<source media="(max-width: 700px)" srcset={`/secteurs/${s.slug}-hero-mobile.webp`} />
						<img src={`/secteurs/${s.slug}-hero.webp`} alt={HERO_ALT[s.slug] ?? ''} loading="lazy" />
					</picture>
				</div>
			</div>
		</section>

		<section class="secteur-body">
			<div class="wrap">
				<h2>Pourquoi personnaliser votre textile</h2>
				<p class="secteur-p">{s.motivation}</p>

				<div class="secteur-insight">
					<span class="secteur-insight-label">Un usage à ne pas négliger</span>
					<p>{s.insight}</p>
				</div>

				<h2>Notre conseil</h2>
				<p class="secteur-p">{s.conseil} <a href={`/techniques/${s.techniqueSlug}`}>En savoir plus sur la technique {technique.nom.toLowerCase()} →</a></p>

				<div class="secteur-exemple">
					<span class="secteur-exemple-label">Exemple type</span>
					<p>{s.exemple}</p>
				</div>

				<h2>Comment commander</h2>
				<div class="secteur-steps">
					<div class="secteur-step">
						<span class="secteur-step-n">1</span>
						<div>
							<strong>Faites le test</strong>
							<p>Trois questions, une recommandation de textile et de technique, et un ordre de prix immédiat — sans attendre un devis par mail.</p>
						</div>
					</div>
					<div class="secteur-step">
						<span class="secteur-step-n">2</span>
						<div>
							<strong>Configurez votre visuel en 3D</strong>
							<p>Le résultat du test pré-remplit directement le configurateur : ajustez la couleur, la taille et la position de votre visuel sur le vêtement.</p>
						</div>
					</div>
					<div class="secteur-step">
						<span class="secteur-step-n">3</span>
						<div>
							<strong>Validez avant production</strong>
							<p>Un aperçu de votre projet réel vous permet de vérifier l'emplacement exact de votre personnalisation sur votre référence textile. Rien ne part en fabrication sans votre accord.</p>
						</div>
					</div>
				</div>

				<div class="secteur-cta">
					<a class="btn" href="/commencer">Faire le test</a>
					<span class="secteur-cta-or">ou <a href="/contact">contactez-nous directement</a></span>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* ---------- en-tête : titre agrandi + photo alignée sur le texte ---------- */
	.secteur-hero {
		padding: 56px 0 60px;
		border-bottom: 1px solid var(--ligne);
	}
	.secteur-hero .crumb {
		font-size: 13px;
		color: var(--gris);
		margin-bottom: 14px;
	}
	.secteur-hero .crumb a {
		text-decoration: none;
		color: var(--gris);
	}
	.secteur-hero .crumb a:hover {
		color: var(--indigo);
	}
	/* Titre nettement agrandi (Milio, 2026-09-15 : « le texte est trop
	   petit, il ne prend pas du tout l'espace qu'il faut ») — ces pages
	   jouent le rôle de page d'atterrissage par secteur, elles méritent
	   un traitement plus affirmé que le simple H1 du Guide. */
	.secteur-hero h1 {
		font-family: 'Anton', system-ui, sans-serif;
		font-weight: 400;
		font-size: clamp(2.2rem, 5vw, 3.6rem);
		letter-spacing: -0.03em;
		max-width: 22ch;
	}
	.secteur-hero p {
		color: var(--gris);
		margin-top: 14px;
		max-width: 64ch;
		font-size: 1.02rem;
	}
	/* Remplace l'ancien bandeau violet + pictogramme (Milio, 2026-09-15 :
	   « le fond violet avec les deux personnes, tu me changes ça avec une
	   image de loin d'une asso dans le sport ») — surtout, la photo vit
	   DANS le même .wrap que le titre, pour garantir qu'elle est alignée
	   avec le texte plutôt que plaquée à part en pleine largeur (l'ancien
	   bandeau, en dehors du .wrap, n'était d'ailleurs même pas centré :
	   aspect-ratio + max-height calculaient sa largeur à partir de la
	   hauteur plafonnée, au lieu de remplir la colonne). */
	.secteur-photo {
		margin-top: 36px;
		width: 100%;
		aspect-ratio: 3 / 1;
		border-radius: 20px;
		overflow: hidden;
	}
	.secteur-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	@media (max-width: 700px) {
		.secteur-photo {
			aspect-ratio: 4 / 3;
		}
	}

	.secteur-body {
		padding: 44px 0 60px;
		max-width: 760px;
		margin: 0 auto;
	}
	.secteur-body h2 {
		font-size: 1.25rem;
		margin: 46px 0 14px;
	}
	.secteur-body h2:first-of-type {
		margin-top: 0;
	}
	.secteur-p {
		color: var(--gris);
		font-size: 1rem;
		line-height: 1.65;
	}
	.secteur-p a {
		color: var(--indigo);
	}

	.secteur-insight,
	.secteur-exemple {
		border-radius: 0 14px 14px 0;
		padding: 18px 22px;
		margin: 24px 0;
	}
	.secteur-insight {
		background: var(--lavande);
		border-left: 3px solid var(--indigo);
	}
	.secteur-exemple {
		background: #fff;
		border: 1.5px solid var(--ligne);
		border-left: 3px solid var(--jaune);
		border-radius: 14px;
	}
	.secteur-insight-label,
	.secteur-exemple-label {
		display: block;
		font-family: 'Sora', sans-serif;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 600;
		margin-bottom: 8px;
	}
	.secteur-insight-label {
		color: var(--indigo);
	}
	.secteur-exemple-label {
		color: #96650f;
	}
	.secteur-insight p,
	.secteur-exemple p {
		margin: 0;
		font-size: 0.95rem;
	}

	.secteur-steps {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.secteur-step {
		display: grid;
		grid-template-columns: 34px 1fr;
		gap: 16px;
		align-items: start;
	}
	.secteur-step-n {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1.5px solid var(--indigo);
		color: var(--indigo);
		font-family: 'Sora', sans-serif;
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.secteur-step strong {
		display: block;
		font-size: 1rem;
		margin-bottom: 4px;
	}
	.secteur-step p {
		color: var(--gris);
		font-size: 0.92rem;
		margin: 0;
	}

	.secteur-cta {
		margin-top: 40px;
		padding-top: 32px;
		border-top: 1px solid var(--ligne);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 18px;
	}
	.secteur-cta-or {
		font-size: 13.5px;
		color: var(--gris);
	}
	.secteur-cta-or a {
		color: var(--indigo);
	}

</style>
