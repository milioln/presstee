---
// Une page dédiée par secteur d'activité, développée pour être trouvée
// depuis une recherche propre à ce secteur (« t-shirt personnalisé
// association », « polo brodé entreprise »…) et pour vraiment aider le
// visiteur à se décider et à commander — pas seulement une fiche
// technique (Milio, 2026-09-10 puis 2026-09-15 : « plus d'éléments
// graphiques, un meilleur article, un CTA qui ne prétend pas plus qu'il
// ne fait »). Contenu : src/data/secteurs.ts (source commune avec la
// liste de puces "Des conseils par activité" de l'accueil et du guide).
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SECTEURS } from '../../data/secteurs';
import { getTechnique } from '../../lib/techniques-data';
import { siteConfig } from '../../config/site';
import '../../styles/global.css';
import '../../styles/techniques.css';

export function getStaticPaths() {
	return SECTEURS.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: (typeof SECTEURS)[number] };
const autres = SECTEURS.filter((x) => x.slug !== s.slug);
const technique = getTechnique(s.techniqueSlug)!;

const serviceLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	serviceType: 'Personnalisation textile',
	name: `Textile personnalisé pour ${s.nom.toLowerCase()}`,
	description: s.texte,
	url: `https://presstee.fr/secteurs/${s.slug}`,
	provider: { '@type': 'Organization', name: siteConfig.nom, url: 'https://presstee.fr' },
	areaServed: { '@type': 'Place', name: `${siteConfig.adresse.ville}, ${siteConfig.adresse.departement}` },
};
---

<Layout
	title={`Textile personnalisé pour ${s.nom.toLowerCase()} — Presstee`}
	description={`${s.texte} Technique conseillée : ${technique.nom.toLowerCase()}.`}
>
	<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
	<Header />
	<main>
		<section class="tech-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / <a href="/#pourqui">Secteurs</a> / {s.nom}</div>
				<h1>Textile personnalisé pour {s.nom.toLowerCase()}.</h1>
				<p>{s.texte}</p>
				<a class="btn" href="/commencer">Faire le test</a>
			</div>
		</section>

		<div class="secteur-visual">
			<span class="secteur-visual-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:clamp(56px,8vw,84px);height:clamp(56px,8vw,84px)">${s.icon}</svg>`} />
			<span class="regmark secteur-visual-mark secteur-visual-mark-a" aria-hidden="true"></span>
			<span class="regmark secteur-visual-mark secteur-visual-mark-b" aria-hidden="true"></span>
		</div>

		<section class="secteur-body">
			<div class="wrap">
				<h2>Pourquoi personnaliser votre textile</h2>
				<p class="secteur-p">{s.motivation}</p>

				<div class="secteur-insight">
					<span class="secteur-insight-label">Un usage à ne pas négliger</span>
					<p>{s.insight}</p>
				</div>

				<h2>Notre conseil</h2>
				<p class="secteur-p">{s.conseil} <a href={`/techniques/${s.techniqueSlug}`}>En savoir plus sur la technique {technique.nom.toLowerCase()} →</a></p>

				<div class="secteur-exemple">
					<span class="secteur-exemple-label">Exemple type</span>
					<p>{s.exemple}</p>
				</div>

				<h2>Comment commander</h2>
				<div class="secteur-steps">
					<div class="secteur-step">
						<span class="secteur-step-n">1</span>
						<div>
							<strong>Faites le test</strong>
							<p>Trois questions, une recommandation de textile et de technique, et un ordre de prix immédiat — sans attendre un devis par mail.</p>
						</div>
					</div>
					<div class="secteur-step">
						<span class="secteur-step-n">2</span>
						<div>
							<strong>Configurez votre visuel en 3D</strong>
							<p>Le résultat du test pré-remplit directement le configurateur : ajustez la couleur, la taille et la position de votre visuel sur le vêtement.</p>
						</div>
					</div>
					<div class="secteur-step">
						<span class="secteur-step-n">3</span>
						<div>
							<strong>Validez avant production</strong>
							<p>Un aperçu automatique (bon à tirer) de votre projet vous permet de tout valider avant lancement. Rien ne part en fabrication sans votre accord.</p>
						</div>
					</div>
				</div>

				<div class="secteur-cta">
					<a class="btn" href="/commencer">Faire le test</a>
					<span class="secteur-cta-or">ou <a href="/contact">contactez-nous directement</a></span>
				</div>
			</div>
		</section>

		<section class="secteur-autres">
			<div class="wrap">
				<h2>Les autres secteurs</h2>
				<div class="secteur-autres-grid">
					{autres.map((a) => (
						<a class="secteur-autres-card" href={`/secteurs/${a.slug}`}>
							<span class="secteur-autres-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:26px;height:26px">${a.icon}</svg>`} />
							<span>{a.nom}</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* ---------- bandeau visuel (tient lieu de photo, en attendant de
	   vraies images par secteur — cf. commentaire de secteurs.ts) ---------- */
	.secteur-visual {
		position: relative;
		overflow: hidden;
		aspect-ratio: 21 / 6;
		max-height: 220px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--indigo);
		background-image: radial-gradient(circle, rgba(255, 255, 255, 0.14) 1.2px, transparent 1.6px);
		background-size: 16px 16px;
	}
	.secteur-visual-icon {
		display: flex;
		color: #fff;
		opacity: 0.92;
	}
	.secteur-visual-mark {
		color: #fff;
		opacity: 0.5;
	}
	.secteur-visual-mark-a {
		top: 22px;
		left: 26px;
	}
	.secteur-visual-mark-b {
		bottom: 22px;
		right: 26px;
	}

	.secteur-body {
		padding: 44px 0 60px;
		max-width: 760px;
		margin: 0 auto;
	}
	.secteur-body h2 {
		font-size: 1.25rem;
		margin: 46px 0 14px;
	}
	.secteur-body h2:first-of-type {
		margin-top: 0;
	}
	.secteur-p {
		color: var(--gris);
		font-size: 1rem;
		line-height: 1.65;
	}
	.secteur-p a {
		color: var(--indigo);
	}

	.secteur-insight,
	.secteur-exemple {
		border-radius: 0 14px 14px 0;
		padding: 18px 22px;
		margin: 24px 0;
	}
	.secteur-insight {
		background: var(--lavande);
		border-left: 3px solid var(--indigo);
	}
	.secteur-exemple {
		background: #fff;
		border: 1.5px solid var(--ligne);
		border-left: 3px solid var(--jaune);
		border-radius: 14px;
	}
	.secteur-insight-label,
	.secteur-exemple-label {
		display: block;
		font-family: 'Sora', sans-serif;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 600;
		margin-bottom: 8px;
	}
	.secteur-insight-label {
		color: var(--indigo);
	}
	.secteur-exemple-label {
		color: #96650f;
	}
	.secteur-insight p,
	.secteur-exemple p {
		margin: 0;
		font-size: 0.95rem;
	}

	.secteur-steps {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.secteur-step {
		display: grid;
		grid-template-columns: 34px 1fr;
		gap: 16px;
		align-items: start;
	}
	.secteur-step-n {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1.5px solid var(--indigo);
		color: var(--indigo);
		font-family: 'Sora', sans-serif;
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.secteur-step strong {
		display: block;
		font-size: 1rem;
		margin-bottom: 4px;
	}
	.secteur-step p {
		color: var(--gris);
		font-size: 0.92rem;
		margin: 0;
	}

	.secteur-cta {
		margin-top: 40px;
		padding-top: 32px;
		border-top: 1px solid var(--ligne);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 18px;
	}
	.secteur-cta-or {
		font-size: 13.5px;
		color: var(--gris);
	}
	.secteur-cta-or a {
		color: var(--indigo);
	}

	/* ---------- les autres secteurs ---------- */
	.secteur-autres {
		background: var(--lavande);
		padding: 50px 0 64px;
	}
	.secteur-autres h2 {
		font-size: 1.2rem;
		margin: 0 0 22px;
	}
	.secteur-autres-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
	}
	.secteur-autres-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		text-align: center;
		background: #fff;
		border: 1.5px solid var(--ligne);
		border-radius: 16px;
		padding: 20px 12px;
		text-decoration: none;
		color: var(--encre);
		font-size: 13.5px;
		font-weight: 600;
		transition: border-color 0.15s, transform 0.15s;
	}
	.secteur-autres-card:hover {
		border-color: var(--indigo);
		transform: translateY(-2px);
	}
	.secteur-autres-icon {
		display: flex;
		color: var(--indigo);
	}

	@media (max-width: 700px) {
		.secteur-autres-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
