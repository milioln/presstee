---
// Page Contact dédiée — remplace l'ancre /#commander de l'accueil,
// recréée en Astro à partir du gabarit fourni par Milio (Contact.dc.html).
// Le formulaire envoie par mailto: comme partout ailleurs sur le site
// (panier, simulateur, bon à tirer) plutôt que d'être désactivé en
// attendant un vrai backend : mailto ne dépend d'aucun SIRET ni serveur,
// c'est justement pour ça qu'il est déjà utilisé partout ici (cf.
// cart.ts). Un lien mailto: ne peut en revanche pas transporter de
// pièce jointe à lui seul : le visuel est donc téléversé séparément
// (public/api/upload-visuel-contact.php, endpoint public sans clé —
// validation par extension + signature du fichier, jamais par le nom
// ou le type déclaré par le client) puis son lien est inclus dans le
// corps du mail, plutôt que de demander au client de le joindre
// lui-même après coup.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import { LABELS_TYPE_TEXTILE, type TypeTextile } from '../lib/produits-types';
import '../styles/global.css';
import '../styles/contact.css';

const typesTextile = Object.keys(LABELS_TYPE_TEXTILE) as TypeTextile[];
---

<Layout title="Contact — Presstee" description="Décrivez votre projet, recevez une recommandation de textile et un devis chiffré sous 24 heures ouvrées.">
	<Header />
	<main>
		<section class="contact-hero">
			<div class="wrap">
				<div class="crumb"><a href="/">Accueil</a> / Contact</div>
				<h1>Décrire le projet,<br />obtenir un prix.</h1>
				<p>Un visuel, une quantité, une date : c'est assez pour recevoir une recommandation de textile et un devis chiffré. Réponse sous 24 heures ouvrées.</p>
			</div>
		</section>

		<section class="contact-body">
			<div class="wrap contact-grid">
				<div class="contact-form-card">
					<h2>Demande de devis</h2>
					<p class="contact-form-hint">Les champs marqués d'un astérisque sont nécessaires pour chiffrer.</p>

					<form id="contactForm">
						<div class="contact-row2">
							<label>
								<span>Nom *</span>
								<input type="text" id="cNom" placeholder="Prénom et nom" required />
							</label>
							<label>
								<span>Structure</span>
								<input type="text" id="cStructure" placeholder="Association, entreprise, club…" />
							</label>
							<label>
								<span>E-mail *</span>
								<input type="email" id="cEmail" placeholder="vous@exemple.fr" required />
							</label>
							<label>
								<span>Téléphone</span>
								<input type="tel" id="cTel" placeholder="06 …" />
							</label>
						</div>

						<div class="contact-field contact-pro" id="contactPro" hidden>
							<span class="contact-label">Informations de facturation <span class="contact-optional">(facultatif)</span></span>
							<div class="contact-row2">
								<label>
									<span>SIRET</span>
									<input type="text" id="cSiret" placeholder="14 chiffres" inputmode="numeric" />
								</label>
								<label>
									<span>Bon de commande interne</span>
									<input type="text" id="cBonCommande" placeholder="Référence, si vous en avez une" />
								</label>
							</div>
							<label>
								<span>Adresse de facturation</span>
								<input type="text" id="cAdresseFacturation" placeholder="Si différente de l'adresse de contact" />
							</label>
						</div>

						<div class="contact-sep"></div>

						<div class="contact-field">
							<span class="contact-label">Type de textile souhaité</span>
							<div class="contact-pills">
								{typesTextile.map((t, i) => (
									<label class="contact-pill"><input type="radio" name="typeTextile" value={LABELS_TYPE_TEXTILE[t]} checked={i === 0} />{LABELS_TYPE_TEXTILE[t]}</label>
								))}
							</div>
						</div>

						<div class="contact-field">
							<span class="contact-label">Technique souhaitée</span>
							<div class="contact-pills">
								<label class="contact-pill"><input type="radio" name="technique" value="Sérigraphie" />Sérigraphie</label>
								<label class="contact-pill"><input type="radio" name="technique" value="Transfert" />Transfert</label>
								<label class="contact-pill"><input type="radio" name="technique" value="Broderie" />Broderie</label>
								<label class="contact-pill"><input type="radio" name="technique" value="À conseiller" checked />À conseiller</label>
							</div>
						</div>

						<div class="contact-row2">
							<label>
								<span>Quantité *</span>
								<input type="number" id="cQte" value="25" min="1" required />
							</label>
							<label>
								<span>Date souhaitée</span>
								<input type="date" id="cDate" />
							</label>
						</div>

						<label class="contact-field">
							<span class="contact-label">Le projet *</span>
							<textarea id="cProjet" rows="5" placeholder="Support, nombre de couleurs, emplacement du marquage, tailles…" required></textarea>
						</label>

						<label class="contact-file" for="cFichier">
							<div>
								<div class="contact-file-title">Visuel à imprimer</div>
								<div class="contact-file-note" id="cFichierNote">PDF, AI, EPS, SVG, PNG, JPG ou WEBP — 20 Mo maximum. Facultatif, mais accélère le chiffrage.</div>
							</div>
							<span class="contact-file-btn">Choisir un fichier</span>
							<input type="file" id="cFichier" accept=".pdf,.ai,.eps,.svg,.png,.jpg,.jpeg,.webp" hidden />
						</label>

						<button type="submit" class="btn contact-submit" id="contactSubmit">Envoyer la demande</button>
					</form>
				</div>

				<aside class="contact-side">
					<div class="contact-card">
						<h3>Contact direct</h3>
						<div class="contact-direct">
							<div>
								<span class="contact-side-label">E-mail</span>
								<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
							</div>
							<div>
								<span class="contact-side-label">Téléphone</span>
								<a href={`tel:${siteConfig.telephone.replace(/\s/g, '')}`}>{siteConfig.telephone}</a>
							</div>
							<div>
								<span class="contact-side-label">Atelier</span>
								<span class="contact-static">{siteConfig.adresse.ville}, {siteConfig.adresse.departement}</span>
							</div>
						</div>
					</div>

					<div class="contact-delay">
						<div class="contact-delay-num">24 h ouvrées</div>
						<div class="contact-delay-label">délai de réponse habituel sur une demande de devis</div>
					</div>

					<div class="contact-card">
						<h3>Ce qui accélère le chiffrage</h3>
						<div class="contact-tips">
							<div class="contact-tip"><span class="contact-tip-num" style="transform:rotate(-6deg)">1</span><span>Le visuel en vectoriel, ou en 300 dpi à la taille d'impression.</span></div>
							<div class="contact-tip"><span class="contact-tip-num" style="transform:rotate(4deg)">2</span><span>Le nombre de couleurs du marquage et son emplacement.</span></div>
							<div class="contact-tip"><span class="contact-tip-num" style="transform:rotate(-3deg)">3</span><span>La répartition des tailles, même approximative.</span></div>
						</div>
					</div>

					<div class="contact-card">
						<h3>Retrait et rendez-vous</h3>
						<p>Retrait sur place à Angoulême ou envoi par transporteur. Les rendez-vous à l'atelier se prennent par e-mail ou par téléphone.</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="contact-band">
			<div class="wrap">
				<h2>Pas besoin d'attendre une réponse pour avancer</h2>
				<div class="contact-band-grid">
					<a class="contact-band-card" href="/personnaliser?mode=3d">
						<h3>Configurateur</h3>
						<p>Placer le visuel sur le textile et voir le rendu avant de commander.</p>
						<span>Ouvrir</span>
					</a>
					<a class="contact-band-card" href="/commencer">
						<h3>Quiz rapide</h3>
						<p>Trois questions, une estimation immédiate selon la quantité, la technique et le textile.</p>
						<span>Estimer</span>
					</a>
					<a class="contact-band-card" href="/produits">
						<h3>Catalogue textile</h3>
						<p>Les bases disponibles, avec grammage, coupe et prix dégressifs.</p>
						<span>Parcourir</span>
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { siteConfig } from '../config/site';
	import { getProfil } from '../lib/profil-client';

	function el<T extends HTMLElement = HTMLElement>(id: string): T {
		return document.getElementById(id) as T;
	}

	// Bloc SIRET/facturation affiché dès que "Structure" est renseigné, ou
	// d'emblée si le visiteur s'est déjà déclaré professionnel ailleurs sur
	// le site (accueil, SectorSelector) — jamais un champ obligatoire.
	const proBlock = el('contactPro');
	const structureInput = el<HTMLInputElement>('cStructure');
	function syncProBlock(): void {
		proBlock.hidden = !structureInput.value.trim() && getProfil() !== 'entreprise';
	}
	structureInput.addEventListener('input', syncProBlock);
	syncProBlock();

	const NOTE_DEFAUT = el('cFichierNote').textContent!;
	const fichierInput = el<HTMLInputElement>('cFichier');
	const fichierLabel = fichierInput.closest<HTMLLabelElement>('.contact-file')!;

	fichierInput.addEventListener('change', () => {
		const f = fichierInput.files?.[0];
		fichierLabel.classList.toggle('has-file', !!f);
		el('cFichierNote').textContent = f ? `${f.name} (${(f.size / 1024 / 1024).toFixed(1)} Mo)` : NOTE_DEFAUT;
	});

	async function televerserFichier(f: File): Promise<{ ok: true; url: string } | { ok: false; error: string }> {
		const form = new FormData();
		form.append('fichier', f);
		try {
			const res = await fetch('/api/upload-visuel-contact.php', { method: 'POST', body: form });
			const data = await res.json();
			if (!res.ok || !data.ok) return { ok: false, error: data.error || 'Échec du téléversement.' };
			return { ok: true, url: data.url };
		} catch {
			return { ok: false, error: 'Échec du téléversement (connexion).' };
		}
	}

	document.getElementById('contactForm')!.addEventListener('submit', async (e) => {
		e.preventDefault();
		const submitBtn = el<HTMLButtonElement>('contactSubmit');
		const nom = el<HTMLInputElement>('cNom').value.trim();
		const structure = el<HTMLInputElement>('cStructure').value.trim();
		const emailClient = el<HTMLInputElement>('cEmail').value.trim();
		const tel = el<HTMLInputElement>('cTel').value.trim();
		const typeTextile = (document.querySelector('input[name="typeTextile"]:checked') as HTMLInputElement)?.value || '';
		const technique = (document.querySelector('input[name="technique"]:checked') as HTMLInputElement)?.value || 'À conseiller';
		const qte = el<HTMLInputElement>('cQte').value.trim();
		const date = el<HTMLInputElement>('cDate').value.trim();
		const projet = el<HTMLTextAreaElement>('cProjet').value.trim();
		const fichier = fichierInput.files?.[0] ?? null;

		let visuelUrl: string | null = null;
		if (fichier) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Envoi du visuel…';
			const resultat = await televerserFichier(fichier);
			if (!resultat.ok) {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Envoyer la demande';
				el('cFichierNote').textContent = resultat.error;
				fichierLabel.classList.remove('has-file');
				return;
			}
			visuelUrl = new URL(resultat.url, window.location.origin).toString();
			submitBtn.textContent = 'Envoyer la demande';
			submitBtn.disabled = false;
		}

		const siret = el<HTMLInputElement>('cSiret').value.trim();
		const bonCommande = el<HTMLInputElement>('cBonCommande').value.trim();
		const adresseFacturation = el<HTMLInputElement>('cAdresseFacturation').value.trim();

		const lignes = [
			`Nom : ${nom}`,
			structure ? `Structure : ${structure}` : null,
			`E-mail : ${emailClient}`,
			tel ? `Téléphone : ${tel}` : null,
			siret ? `SIRET : ${siret}` : null,
			bonCommande ? `Bon de commande interne : ${bonCommande}` : null,
			adresseFacturation ? `Adresse de facturation : ${adresseFacturation}` : null,
			`Type de textile souhaité : ${typeTextile}`,
			`Technique souhaitée : ${technique}`,
			`Quantité : ${qte}`,
			date ? `Date souhaitée : ${date}` : null,
			'',
			'Le projet :',
			projet,
			visuelUrl ? `\nVisuel joint : ${visuelUrl}` : null,
		].filter((l): l is string => l != null);

		const body = `Bonjour,\n\n${lignes.join('\n')}`;
		const url = `mailto:${siteConfig.email}?subject=${encodeURIComponent(`Demande de devis — ${nom || 'contact site'}`)}&body=${encodeURIComponent(body)}`;
		window.location.href = url;
	});
</script>
