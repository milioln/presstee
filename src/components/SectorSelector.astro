---
// Contenu éditorial provisoire (fourchettes de volumes, grammages,
// techniques conseillées par secteur) — à valider par Milio avant
// publication. Deviendra une collection de contenu en session 3
// (document de passage, section 4 et 7).
const DOMS = [
	{
		k: 'Associations',
		p: "Budgets serrés, commandes groupées et renouvellement régulier au fil des événements. L'enjeu est d'obtenir une pièce correcte sans faire exploser la cotisation des adhérents.",
		t: 'T-shirt coton 150 à 180 g/m²',
		m: 'Sérigraphie à partir d’une trentaine de pièces',
		q: '30 à 150 pièces',
	},
	{
		k: 'BDE et écoles',
		p: 'Intégration, week-ends, soirées : de grosses séries commandées d’un coup, souvent avec un visuel unique et un délai serré autour de la rentrée.',
		t: 'Sweat molleton 280 à 320 g/m²',
		m: 'Sérigraphie, très rentable sur ces volumes',
		q: '80 à 400 pièces',
	},
	{
		k: 'Entreprises',
		p: 'Uniformiser les équipes et porter l’image de marque, avec une exigence de sobriété et de tenue dans le temps plus forte que sur un textile événementiel.',
		t: 'Polo piqué ou chemise',
		m: 'Broderie sur le cœur, ou transfert monochrome',
		q: '10 à 100 pièces',
	},
	{
		k: 'Bars et restaurants',
		p: 'Tenues portées tous les jours et lavées à haute température. Le marquage doit tenir plusieurs centaines de lavages sans se fissurer.',
		t: 'T-shirt épais 185 g/m² ou tablier',
		m: 'Transfert monochrome sous 25 pièces, sérigraphie au-delà',
		q: '10 à 60 pièces',
	},
	{
		k: 'Événements',
		p: 'Délai court, quantité parfois incertaine jusqu’au dernier moment, et un visuel souvent riche en couleurs. La réactivité prime sur la durabilité.',
		t: 'T-shirt léger 150 g/m²',
		m: 'Transfert quadrichromie, sans frais de calage',
		q: '20 à 300 pièces',
	},
	{
		k: 'Commerces',
		p: 'Petites séries, parfois des collections capsule à tester avant de réassortir. Le rendu compte autant que le prix, puisque la pièce est vendue.',
		t: 'Coton lourd 200 g/m² et plus',
		m: 'Sérigraphie ou transfert monochrome',
		q: '20 à 100 pièces',
	},
	{
		k: 'Boulangeries',
		p: 'Image artisanale et tenue professionnelle, avec un textile qui encaisse la farine, la chaleur et les lavages fréquents.',
		t: 'Tablier ou polo',
		m: 'Broderie, pour le rendu et la tenue',
		q: '10 à 30 pièces',
	},
	{
		k: 'Clubs sportifs',
		p: 'Maillots techniques, floquage de noms et de numéros, et un renouvellement partiel chaque saison plutôt qu’une commande unique.',
		t: 'Maillot polyester respirant',
		m: 'Transfert monochrome, adapté aux textiles techniques',
		q: '15 à 60 pièces',
	},
];
---

<section id="secteurs">
	<div class="wrap">
		<div class="head-center">
			<h2>Votre activité, vos contraintes.</h2>
			<p style="color:var(--gris)">Sélectionnez votre domaine : nous vous montrons ce que commandent les structures comme la vôtre, et ce que nous leur conseillons.</p>
		</div>
		<div class="profilToggle" id="profilToggle" role="group" aria-label="Votre profil">
			<button type="button" data-profil="particulier">Je suis un particulier</button>
			<button type="button" data-profil="entreprise">Je représente une structure</button>
		</div>
		<div class="doms" id="doms"></div>
		<div class="dompanel" id="dompanel"></div>
	</div>
</section>

<script define:vars={{ DOMS }}>
	// Domaines clairement pro (portés au premier plan quand le visiteur se
	// déclare "professionnel") vs particuliers/associatifs — même liste que
	// celle déjà éditorialisée dans DOMS, juste réordonnée à l'affichage.
	const PRO = new Set(['Entreprises', 'Bars et restaurants', 'Commerces', 'Boulangeries']);

	const doms = document.getElementById('doms');
	const dompanel = document.getElementById('dompanel');
	const profilToggle = document.getElementById('profilToggle');
	let dsel = 0;
	let ordre = DOMS.map((_, i) => i);

	function applyProfil(p) {
		try {
			localStorage.setItem('presstee:profil-client', p);
		} catch {
			// Stockage indisponible : le tri reste appliqué pour cette visite.
		}
		ordre = DOMS.map((_, i) => i).sort((a, b) => {
			const pa = PRO.has(DOMS[a].k) ? 0 : 1;
			const pb = PRO.has(DOMS[b].k) ? 0 : 1;
			const rank = p === 'entreprise' ? [pa, pb] : [1 - pa, 1 - pb];
			return rank[0] - rank[1];
		});
		dsel = ordre[0];
		profilToggle.querySelectorAll('[data-profil]').forEach((b) => b.classList.toggle('on', b.dataset.profil === p));
		paintDoms();
	}

	function paintDoms() {
		doms.innerHTML = ordre.map((i) => `<button class="dom${i === dsel ? ' on' : ''}" data-d="${i}">${DOMS[i].k}</button>`).join('');
		const d = DOMS[dsel];
		dompanel.innerHTML = `<div><h3>${d.k}</h3><p>${d.p}</p></div>
			<div class="domfacts">
				<div class="fact"><b>Textile souvent retenu</b><span>${d.t}</span></div>
				<div class="fact"><b>Marquage conseillé</b><span>${d.m}</span></div>
				<div class="fact"><b>Volumes habituels</b><span>${d.q}</span></div>
			</div>`;
	}

	doms.addEventListener('click', (e) => {
		const b = e.target.closest('[data-d]');
		if (!b) return;
		dsel = +b.dataset.d;
		paintDoms();
	});

	profilToggle.addEventListener('click', (e) => {
		const b = e.target.closest('[data-profil]');
		if (!b) return;
		applyProfil(b.dataset.profil);
	});

	try {
		const saved = localStorage.getItem('presstee:profil-client');
		if (saved === 'particulier' || saved === 'entreprise') applyProfil(saved);
		else paintDoms();
	} catch {
		paintDoms();
	}

	// Un autre point du site (accueil, /contact...) peut fixer le profil
	// après le chargement de cette section — on réagit au même évènement
	// plutôt qu'à une relecture périodique du storage.
	document.addEventListener('presstee:profil-client', (e) => applyProfil(e.detail));
</script>
