---
// Contenu par secteur : source unique dans src/data/secteurs.ts,
// partagée avec les pages dédiées /secteurs/[slug] (une page par
// secteur, référençable depuis une recherche propre à ce secteur).
import { SECTEURS } from '../data/secteurs';
const DOMS = SECTEURS.map((s) => ({ k: s.nom, p: s.texte, t: s.textile, m: s.marquage, q: s.volumes, i: s.insight, slug: s.slug }));
---

<section id="secteurs">
	<div class="wrap">
		<div class="head-center">
			<h2>Votre activité, vos contraintes.</h2>
			<p style="color:var(--gris)">Sélectionnez votre domaine : nous vous montrons ce que commandent les structures comme la vôtre, et ce que nous leur conseillons.</p>
		</div>
		<div class="doms" id="doms"></div>
		<div class="dompanel" id="dompanel"></div>
	</div>
</section>

<script define:vars={{ DOMS }}>
	const doms = document.getElementById('doms');
	const dompanel = document.getElementById('dompanel');
	let dsel = 0;

	function paintDoms() {
		doms.innerHTML = DOMS.map((d, i) => `<button class="dom${i === dsel ? ' on' : ''}" data-d="${i}">${d.k}</button>`).join('');
		const d = DOMS[dsel];
		dompanel.innerHTML = `<div><h3>${d.k}</h3><p>${d.p}</p>
				<p class="dompanel-insight">${d.i}</p>
				<div class="dompanel-cta">
					<a class="btn" href="/commencer">Commencer un projet</a>
					<a class="dompanel-more" href="/secteurs/${d.slug}">Voir le détail pour ${d.k.toLowerCase()} →</a>
				</div>
			</div>
			<div class="domfacts">
				<div class="fact"><b>Textile souvent retenu</b><span>${d.t}</span></div>
				<div class="fact"><b>Marquage conseillé</b><span>${d.m}</span></div>
				<div class="fact"><b>Volumes habituels</b><span>${d.q}</span></div>
			</div>`;
	}

	doms.addEventListener('click', (e) => {
		const b = e.target.closest('[data-d]');
		if (!b) return;
		dsel = +b.dataset.d;
		paintDoms();
	});

	paintDoms();
</script>
