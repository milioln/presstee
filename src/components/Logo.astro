---
// Logo réel (lettrage Ananias vectorisé en tracés, fourni par Milio) —
// remplace le SVG approximatif de la V0. Fichiers sources dans
// public/logo/ ; originaux non recadrés dans reference/logo-source/.
interface Props {
  size?: number;
  variant?: 'horizontal' | 'icone' | 'vertical';
}

const { size = 36, variant = 'horizontal' } = Astro.props;

const files = {
  horizontal: '/logo/presstee-horizontal.svg',
  icone: '/logo/presstee-icone.svg',
  vertical: '/logo/presstee-vertical.svg',
};
---

<img src={files[variant]} alt="Presstee" height={size} style={`height:${size}px;width:auto`} />
