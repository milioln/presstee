---
// Simulateur de technique de marquage — trois questions, une
// recommandation. Composant partagé entre la page Guide (/techniques,
// où il vivait à l'origine) et la page d'accueil, pour que le
// simulateur soit réellement utilisable aux deux endroits plutôt que
// remplacé par un simple teaser statique sur l'accueil.
//
// Règles confirmées par Milio (2026-09-02), les mêmes que le moteur de
// recommandation du configurateur (src/scripts/personnalisateur/recommendation.ts) :
// sérigraphie à partir de 25 pièces et jusqu'à 4 couleurs ; broderie à
// partir de 10 pièces et jusqu'à 8 couleurs de fil ; transfert
// monochrome pour l'aplat unique hors zone sérigraphie ; transfert
// quadrichromie en repli pour le reste (dégradés/photos, ou quantité
// et couleurs hors zone des trois autres techniques).
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['tsim', className]} id="tsim">
	<span class="tsim-eyebrow"><span class="regmark" aria-hidden="true"></span>Simulateur — 30 secondes</span>
	<h2>Quelle technique pour mon projet ?</h2>
	<p>Trois questions, une recommandation. C'est la même logique que celle utilisée dans notre configurateur — répondez ici pour vous décider avant de vous lancer, ou directement dans le configurateur avec votre propre visuel.</p>
	<div class="tsim-grid">
		<div class="tsim-field">
			<label>Quantité de pièces</label>
			<div class="pills" id="simQty">
				<button class="pill" data-qty="5">Moins de 10</button>
				<button class="pill" data-qty="15">10 à 24</button>
				<button class="pill" data-qty="50">25 à 100</button>
				<button class="pill" data-qty="200">Plus de 100</button>
			</div>
		</div>
		<div class="tsim-field">
			<label>Nombre de couleurs du visuel</label>
			<div class="pills" id="simColors">
				<button class="pill" data-colors="1">1 couleur</button>
				<button class="pill" data-colors="3">2 à 4</button>
				<button class="pill" data-colors="6">5 à 8</button>
				<button class="pill" data-colors="12">Dégradés / photo</button>
			</div>
		</div>
		<div class="tsim-field">
			<label>Ce qui compte le plus</label>
			<div class="pills" id="simPrio">
				<button class="pill" data-prio="prix">Le prix le plus bas</button>
				<button class="pill" data-prio="rendu">Le rendu le plus qualitatif</button>
				<button class="pill" data-prio="duree">La tenue dans le temps</button>
			</div>
		</div>
	</div>
	<div class="tsim-result" id="simResult">
		<div class="label">Notre recommandation</div>
		<h3 id="simTitle"></h3>
		<p id="simWhy"></p>
		<a class="btn" id="simCta" href="/configurateur">Personnaliser avec cette technique</a>
	</div>
</div>

<script>
	import { getTechnique } from '../lib/techniques-data';

	const SEUIL_SERI_QTY = 25;
	const SEUIL_SERI_COLORS = 4;
	const SEUIL_BRODERIE_QTY = 10;
	const SEUIL_BRODERIE_COLORS = 8;

	const state = { qty: 0, colors: 0, prio: '' };

	function bind(id: string, key: 'qty' | 'colors' | 'prio') {
		const group = document.getElementById(id)!;
		group.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.pill');
			if (!b) return;
			group.querySelectorAll('.pill').forEach((p) => p.classList.remove('on'));
			b.classList.add('on');
			(state as any)[key] = key === 'prio' ? b.dataset[key] : +b.dataset[key]!;
			compute();
		});
	}
	bind('simQty', 'qty');
	bind('simColors', 'colors');
	bind('simPrio', 'prio');

	function compute() {
		if (!state.qty || !state.colors || !state.prio) return;

		let slug: string;
		let why: string;

		if (state.colors >= 10) {
			slug = 'transfert-quadrichromie';
			why = `Dégradés ou photo : seul le transfert quadrichromie les reproduit fidèlement, quelle que soit la quantité.`;
		} else if (state.qty >= SEUIL_SERI_QTY && state.colors <= SEUIL_SERI_COLORS) {
			slug = 'serigraphie';
			why = `${state.qty} pièces pour ${state.colors} couleur${state.colors > 1 ? 's' : ''} : les frais d'écran sont amortis, la sérigraphie devient la plus économique et la plus durable au lavage.`;
		} else if (state.colors === 1) {
			if (state.qty >= SEUIL_BRODERIE_QTY && (state.prio === 'duree' || state.prio === 'rendu')) {
				slug = 'broderie';
				why = `Une couleur, et ${state.prio === 'duree' ? 'la tenue dans le temps compte' : 'le rendu compte'} le plus pour vous : la broderie tient mieux qu'un transfert et offre un rendu plus texturé.`;
			} else {
				slug = 'transfert-monochrome';
				why = `Une seule couleur pour ${state.qty} pièces : sous ${SEUIL_SERI_QTY} pièces, le transfert monochrome revient moins cher que la sérigraphie, sans frais de calage.`;
			}
		} else if (state.qty >= SEUIL_BRODERIE_QTY && state.colors <= SEUIL_BRODERIE_COLORS) {
			slug = 'broderie';
			why = `${state.colors} couleurs de fil pour ${state.qty} pièces : la broderie tient ce nombre de couleurs, avec le rendu le plus durable et sans frais de calage.`;
		} else {
			slug = 'transfert-quadrichromie';
			why = state.colors > SEUIL_BRODERIE_COLORS
				? `${state.colors} couleurs : au-delà de ${SEUIL_BRODERIE_COLORS}, seul le transfert quadrichromie le reproduit fidèlement.`
				: `${state.qty} pièces : trop peu pour la sérigraphie ou la broderie (${SEUIL_BRODERIE_QTY} pièces minimum). Le transfert quadrichromie reste rentable sans minimum de quantité.`;
		}

		document.getElementById('simTitle')!.textContent = getTechnique(slug)?.nom ?? '';
		document.getElementById('simWhy')!.textContent = why;
		const cta = document.getElementById('simCta') as HTMLAnchorElement;
		cta.href = `/configurateur?technique=${slug}`;
		document.getElementById('simResult')!.classList.add('show');
	}
</script>
