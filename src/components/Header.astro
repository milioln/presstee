---
---


<header>
	<div class="wrap nav">
		<a class="brand" href="/#top">
			<img src="/logo/presstee-horizontal-header.webp" alt="Presstee" height="36" style="height:36px;width:auto" />
		</a>
		<button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
			<svg width="24" height="16" viewBox="0 0 24 16"><rect width="24" height="2" rx="1"></rect><rect y="7" width="24" height="2" rx="1"></rect><rect y="14" width="18" height="2" rx="1"></rect></svg>
		</button>
		<nav class="links" id="links">
			<a href="/techniques">Guide</a>
			<a href="/commencer">Commander</a>
			<a href="/produits">Produits</a>
			<a href="/#creations">Réalisations</a>
			<a href="/contact">Contact</a>
			<a href="/panier" class="cart-link">Panier<span class="cart-badge" id="headerCartCount" style="display:none">0</span></a>
			<a href="/compte/connexion" id="accountLink">Connexion</a>
		</nav>
	</div>
</header>

<div class="cursorGlow" aria-hidden="true"></div>

<script>
	import { showEggToast, pulseRegmarks } from '../lib/easter-egg';

	const burger = document.getElementById('burger')!;
	const links = document.getElementById('links')!;
	burger.addEventListener('click', () => {
		const open = links.classList.toggle('open');
		burger.setAttribute('aria-expanded', String(open));
	});
	links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => links.classList.remove('open')));

	// Lueur qui suit le curseur, active sur tout le site (Milio, 2026-09-10
	// — remplace le sillage d'encre qui créait un élément DOM à chaque
	// mouvement et finissait par ralentir la page). Reprend l'effet déjà
	// présent sur le héros de l'accueil (deux variables CSS mises à jour,
	// rien créé ni supprimé) plutôt que de le limiter à cette seule section.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduceMotion) {
		window.addEventListener('mousemove', (e) => {
			document.documentElement.style.setProperty('--cx', ((e.clientX / window.innerWidth) * 100).toFixed(1) + '%');
			document.documentElement.style.setProperty('--cy', ((e.clientY / window.innerHeight) * 100).toFixed(1) + '%');
		});
	}

	try {
		const raw = localStorage.getItem('presstee:personnalisateur:panier');
		const items = raw ? JSON.parse(raw) : [];
		const n = Array.isArray(items) ? items.length : 0;
		const badge = document.getElementById('headerCartCount')!;
		if (n > 0) {
			badge.textContent = String(n);
			badge.style.display = 'inline-flex';
		}
	} catch {
		// Stockage indisponible (navigation privée...) : le badge reste masqué.
	}

	fetch('/api/me.php')
		.then((r) => r.json())
		.then((data) => {
			if (data.authenticated) {
				const link = document.getElementById('accountLink') as HTMLAnchorElement;
				link.textContent = 'Mon compte';
				link.href = '/compte';
			}
		})
		.catch(() => {
			// API indisponible (hors ligne, config serveur pas encore faite...) :
			// le lien reste sur "Connexion" par défaut.
		});

	// Petite surprise cachée : un clic sur le logo. Seulement actif sur
	// l'accueil (le logo y pointe vers lui-même, "/#top" — ailleurs, un
	// clic navigue vers l'accueil avant de pouvoir jouer l'animation, ce
	// qui est très bien : ça ne gêne jamais la navigation normale). Un seul
	// clic suffit (Milio, 2026-09-09 — auparavant 5 clics rapides).
	if (location.pathname === '/') {
		const brand = document.querySelector<HTMLAnchorElement>('.brand')!;
		brand.addEventListener('click', (e) => {
			e.preventDefault();
			const colors = ['#9d83cf', '#ffd77a', '#BF3B32', '#1F5A4A', '#20304F', '#E4D6BD'];
			const layer = document.createElement('div');
			layer.className = 'eggLayer';
			for (let i = 0; i < 18; i++) {
				const bit = document.createElement('span');
				bit.className = 'eggBit';
				bit.style.left = `${Math.random() * 100}%`;
				bit.style.background = colors[i % colors.length];
				bit.style.animationDelay = `${(Math.random() * 0.4).toFixed(2)}s`;
				bit.style.animationDuration = `${(1.6 + Math.random() * 0.8).toFixed(2)}s`;
				layer.appendChild(bit);
			}
			const toast = document.createElement('div');
			toast.className = 'eggToast';
			toast.textContent = 'Fil retrouvé — merci de fouiner par ici.';
			document.body.append(layer, toast);
			requestAnimationFrame(() => toast.classList.add('show'));
			window.setTimeout(() => toast.classList.remove('show'), 2200);
			window.setTimeout(() => { layer.remove(); toast.remove(); }, 2700);
		});
	}

	// Clin d'œil sitewide : le code Konami classique, ou taper "presstee"
	// au clavier, fait clignoter puis se réaligner tous les repères de
	// calage visibles sur la page actuelle (Milio, 2026-09-09, menu
	// d'easter eggs validé). Ignoré tant qu'un champ de saisie a le focus,
	// pour ne jamais interférer avec une vraie frappe de texte.
	const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight'];
	let konamiProgress = 0;
	let typedBuffer = '';

	function triggerCalageEgg(): void {
		pulseRegmarks();
		showEggToast('Calage parfait.');
	}

	window.addEventListener('keydown', (e) => {
		const tag = (document.activeElement as HTMLElement | null)?.tagName;
		if (tag === 'INPUT' || tag === 'TEXTAREA' || (document.activeElement as HTMLElement | null)?.isContentEditable) return;

		if (e.key === KONAMI[konamiProgress]) {
			konamiProgress += 1;
			if (konamiProgress === KONAMI.length) {
				konamiProgress = 0;
				triggerCalageEgg();
			}
		} else {
			konamiProgress = e.key === KONAMI[0] ? 1 : 0;
		}

		if (e.key.length === 1) {
			typedBuffer = (typedBuffer + e.key).slice(-20).toLowerCase();
			// Vocabulaire du métier, en plus du nom du site (Milio,
			// 2026-09-09, round 2 du menu d'easter eggs — validé).
			if (['presstee', 'calage', 'raclette'].some((w) => typedBuffer.endsWith(w))) {
				typedBuffer = '';
				triggerCalageEgg();
			}
		}
	});
</script>
