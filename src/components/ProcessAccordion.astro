---
// Icônes par étape : le même petit bonhomme-bâton que sur le reste du
// site (Milio, 2026-09-16 : « à la place du rond où il y a un symbole
// dedans, je voudrais ce style de dessin aussi pour les cinq étapes »),
// une pose différente par étape. Le trait utilise currentColor : la
// même icône suit donc le changement de couleur actif/inactif du
// marqueur (cf. .stp .n / .stp.on .n dans global.css) sans variante
// séparée — pas de tête jaune ici, pour rester monochrome dans la
// pastille.
const ICONS = {
	recherche: '<circle cx="12" cy="4.5" r="2.4" fill="currentColor" stroke="none"/><path d="M12 6.9v6.6"/><path d="M12 9.2l-3 2"/><path d="M12 8.8l3-1.6"/><circle cx="16.3" cy="5.4" r="1.5"/><path d="M12 13.5l-3 7.3"/><path d="M12 13.5l3 7.3"/>',
	sac: '<circle cx="10" cy="4.5" r="2.4" fill="currentColor" stroke="none"/><path d="M10 6.9v4.6"/><path d="M10 8.6l-2.6 1.6"/><path d="M10 8.6l2.6 1.6"/><rect x="7.6" y="10.6" width="4.8" height="3.6" rx="0.6"/><path d="M10 14.2l-2.6 6.5"/><path d="M10 14.2l2.6 6.5"/>',
	oeil: '<circle cx="12" cy="4.5" r="2.4" fill="currentColor" stroke="none"/><path d="M12 6.9v6.4"/><path d="M12 9.5l-4-3"/><path d="M12 9.5l4-3"/><path d="M12 13.3l-2.8 7.4"/><path d="M12 13.3l2.8 7.4"/>',
	usine: '<circle cx="12" cy="4.5" r="2.4" fill="currentColor" stroke="none"/><path d="M12 6.9v5"/><path d="M12 9.6l-3.6 1.8"/><path d="M12 9.6l3.6 1.8"/><path d="M6.2 12.7h11.6"/><path d="M12 12.3l-2.8 8.4"/><path d="M12 12.3l2.8 8.4"/>',
	camion: '<circle cx="12" cy="4.3" r="2.3" fill="currentColor" stroke="none"/><path d="M12 6.6v3.4"/><path d="M12 9l-3 1.2"/><path d="M12 9l3 1.2"/><rect x="7.4" y="10" width="9.2" height="7.4" rx="0.8"/><path d="M12 10v7.4M7.4 13.7h9.2"/><path d="M12 17.4l-2.6 4.2"/><path d="M12 17.4l2.6 4.2"/>',
};

const steps = [
	{
		title: 'Votre projet',
		subtitle: 'Comprendre le besoin',
		icon: ICONS.recherche,
		subs: [
			{ h: "L'usage réel", t: "Un t-shirt d'événement porté trois fois et une tenue de service lavée deux fois par semaine n'appellent pas le même textile." },
			{ h: 'La quantité et le budget', t: 'Ce sont eux qui déterminent quelles techniques deviennent intéressantes pour vous.' },
			{ h: 'Le délai souhaité', t: 'Nous vous disons tout de suite s’il est tenable, avant que vous vous engagiez.' },
		],
	},
	{
		title: 'Notre recommandation',
		subtitle: 'Textile + technique',
		icon: ICONS.sac,
		subs: [
			{ h: 'Le textile', t: 'Grammage, matière et coupe choisis pour votre usage, avec plusieurs niveaux de budget quand c’est pertinent.' },
			{ h: 'La technique de marquage', t: 'Sérigraphie, transfert monochrome, transfert quadrichromie ou broderie, selon le visuel, la quantité et le support.' },
			{ h: 'Le prix, détaillé', t: 'Le coût du textile et celui du marquage sont annoncés séparément. Vous voyez d’où vient chaque euro.' },
		],
	},
	{
		title: 'La validation',
		subtitle: 'Vérification + BAT',
		icon: ICONS.oeil,
		subs: [
			{ h: 'La vérification humaine', t: 'Nous contrôlons vos fichiers, la résolution, les dimensions et la faisabilité réelle de l’impression.' },
			{ h: 'Le bon à tirer', t: 'Vous recevez un BAT qui montre le rendu exact de votre projet, à la bonne taille et au bon endroit sur le vêtement.' },
			{ h: 'Votre validation', t: 'Rien ne part en fabrication sans votre accord écrit sur ce BAT — c’est vous qui donnez le feu vert final.' },
		],
	},
	{
		title: 'Notre production',
		subtitle: 'Fabrication + contrôle',
		icon: ICONS.usine,
		subs: [
			{ h: 'La fabrication', t: 'Le marquage est réalisé dans notre atelier, sur les machines dont nous maîtrisons le planning.' },
			{ h: 'Le contrôle pièce par pièce', t: 'Avant emballage, chaque pièce est vérifiée : rendu, positionnement, conformité au BAT validé.' },
		],
	},
	{
		title: 'Votre livraison',
		subtitle: 'Expédition + suivi',
		icon: ICONS.camion,
		subs: [
			{ h: "L'expédition", t: "Emballage soigné et envoi suivi, ou remise en main propre dans le secteur d'Angoulême." },
			{ h: 'Le suivi', t: 'Un interlocuteur unique du premier échange à la réception. Pas de service client anonyme.' },
		],
	},
];
---

<section id="process">
	<div class="wrap">
		<h2 style="max-width:15ch">Un processus clair, étape par étape.</h2>
		<p style="color:var(--gris);margin-top:16px">Cliquez pour voir le détail.</p>
		<div class="acc" id="acc">
			{steps.map((s, i) => (
				<div class:list={['stp', { open: i === 0 }]} data-i={i}>
					<button aria-expanded={i === 0 ? 'true' : 'false'}>
						<span class="n">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
						</span>
						<span class="tt">
							<strong>{s.title}</strong>
							<span>{s.subtitle}</span>
						</span>
						<span class="chev"></span>
					</button>
					<div class="bd">
						<div class="subs">
							{s.subs.map((sub) => (
								<div class="sub">
									<strong>{sub.h}</strong>
									<span>{sub.t}</span>
								</div>
							))}
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const acc = document.getElementById('acc')!;
	const stps = [...acc.querySelectorAll<HTMLElement>('.stp')];

	function paint() {
		const r = acc.getBoundingClientRect();
		const mid = innerHeight * 0.6;
		acc.style.setProperty('--fill', Math.max(0, Math.min(100, ((mid - r.top) / r.height) * 100)) + '%');
		stps.forEach((s) => {
			const n = s.querySelector('.n')!;
			s.classList.toggle('on', n.getBoundingClientRect().top < mid);
		});
	}

	acc.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest('button');
		if (!b) return;
		const s = b.parentElement!;
		const open = s.classList.contains('open');
		stps.forEach((x) => {
			x.classList.remove('open');
			x.querySelector('button')!.setAttribute('aria-expanded', 'false');
		});
		if (!open) {
			s.classList.add('open');
			b.setAttribute('aria-expanded', 'true');
			b.scrollIntoView({ block: 'center' });
		}
		paint();
	});

	paint();
	addEventListener('scroll', paint, { passive: true });
	addEventListener('resize', paint);
</script>
