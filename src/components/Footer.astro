---
import { siteConfig } from '../config/site';
---

<footer>
	<span class="regmark" aria-hidden="true"></span>
	<div class="wrap">
		<div class="fgrid">
			<div>
				<a class="brand" href="/#top" style="margin-bottom:14px">
					<img src="/logo/presstee-horizontal-header.webp" alt="Presstee" height="28" style="height:28px;width:auto" />
				</a>
				<p style="color:var(--gris);font-size:14.5px;max-width:30ch">Atelier de personnalisation textile. {siteConfig.adresse.ville}, {siteConfig.adresse.departement}.</p>
			</div>
			<div>
				<h4>Comprendre</h4>
				<a href="/techniques">Guide des techniques de marquage</a>
				<a href="/#pourqui">Des conseils par activité</a>
				<a href="/#process">Notre processus, étape par étape</a>
			</div>
			<div>
				<h4>Commander</h4>
				<a href="/produits">Produits</a>
				<a href="/packs-et-offres">Packs et offres</a>
				<a href="/faq">FAQ</a>
				<a href="/contact">Contact</a>
			</div>
			<div>
				<h4>Informations</h4>
				<a href="/mentions-legales">Mentions légales</a>
				<a href="/confidentialite">Politique de confidentialité</a>
				<a href="/cgv">Conditions générales de vente</a>
			</div>
		</div>
		<div class="legal">
			<span>© 2026 {siteConfig.nom}</span>
			<span>{siteConfig.siret ? siteConfig.siret : 'SIRET à compléter après immatriculation'}</span>
			<span id="footerNightNote" style="display:none">Vous travaillez tard vous aussi ?</span>
		</div>
	</div>
</footer>

<script>
	// Clin d'œil discret : une ligne de plus en pied de page entre minuit
	// et 5h — l'heure du visiteur, pas celle du serveur (Milio, 2026-09-09,
	// menu d'easter eggs validé).
	const h = new Date().getHours();
	if (h >= 0 && h < 5) {
		const note = document.getElementById('footerNightNote');
		if (note) note.style.display = 'inline';
	}
</script>
