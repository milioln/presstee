---
// Hero de la page d'accueil — t-shirt 3D interactif dans un gabarit
// d'impression. Repris de la maquette fournie par Milio
// (design_handoff_hero/), avec le vrai modèle 3D du configurateur
// (<model-viewer>, glTF + texture composée) à la place du rendu Three.js
// maison de la maquette — voir src/scripts/hero/tshirt-hero.ts.
---

<section class="hero" id="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span>Obtenez</span>
				<span>vos</span>
				<span class="jeu" data-jeu="couleur">textiles</span>
				<span class="jeu" data-jeu="placement">personnalisés</span>
				<span>en</span>
				<span class="jeu jeu-jaune" data-jeu="spin">3 clics.</span>
			</h1>

			<p class="hero-lede">Choisissez la base, posez votre visuel, validez le bon à tirer.</p>

			<div class="hero-actions">
				<a class="btn btn-primary" href="/configurateur">Commencez votre projet</a>
				<a class="btn btn-secondary" href="/produits/t-shirts">Voir le catalogue</a>
			</div>

			<p class="hero-atelier">Atelier à Angoulême, Charente</p>
		</div>

		<div class="hero-zone" id="heroZone">
			<span class="mark mark-tl"></span>
			<span class="mark mark-tr"></span>
			<span class="mark mark-bl"></span>
			<span class="mark mark-br"></span>

			<span class="zone-shadow"></span>

			<model-viewer
				id="heroStage"
				src="/personnalisateur/model/scene.gltf"
				camera-controls
				touch-action="pan-y"
				interaction-prompt="none"
				shadow-intensity="1"
				camera-orbit="0deg 85deg 105%"
				min-camera-orbit="auto 55deg auto"
				max-camera-orbit="auto 115deg auto"
			></model-viewer>

			<div class="zone-bar">
				<div class="coloris" id="heroColoris">
					<button type="button" data-nom="Blanc" aria-label="Coloris blanc" style="background:#ffffff"></button>
					<button type="button" data-nom="Sable" aria-label="Coloris sable" style="background:#E4D6BD"></button>
					<button type="button" data-nom="Indigo" aria-label="Coloris indigo" style="background:#9d83cf"></button>
					<button type="button" data-nom="Noir" aria-label="Coloris noir" style="background:#1B1B1F"></button>
					<button type="button" data-nom="Jaune Presstee" aria-label="Coloris jaune Presstee" style="background:#ffd77a"></button>
					<button type="button" data-nom="Bleu marine" aria-label="Coloris bleu marine" style="background:#20304F"></button>
					<button type="button" data-nom="Rouge" aria-label="Coloris rouge" style="background:#BF3B32"></button>
					<button type="button" data-nom="Vert bouteille" aria-label="Coloris vert bouteille" style="background:#1F5A4A"></button>
					<label class="import" title="Importer votre visuel" aria-label="Importer votre visuel">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
							<polyline points="17 8 12 3 7 8" />
							<line x1="12" y1="3" x2="12" y2="15" />
						</svg>
						<input id="heroFile" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
					</label>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import '@google/model-viewer';
	import { initHero3D } from '../scripts/hero/tshirt-hero';

	const hero = document.getElementById('hero');

	// Lueur et cadre qui suivent le curseur dans toute la section.
	hero?.addEventListener('mousemove', (e) => {
		const r = hero.getBoundingClientRect();
		const x = (e.clientX - r.left) / r.width;
		const y = (e.clientY - r.top) / r.height;
		hero.style.setProperty('--cx', (x * 100).toFixed(1) + '%');
		hero.style.setProperty('--cy', (y * 100).toFixed(1) + '%');
	});

	initHero3D();
</script>

<style>
	.hero {
		position: relative;
		padding: clamp(48px, 5vw, 76px) 0 clamp(52px, 6vw, 84px);
		background-color: #fff;
		background-image: linear-gradient(#f2eff9 1px, transparent 1px), linear-gradient(90deg, #f2eff9 1px, transparent 1px);
		background-size: 52px 52px;
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(420px circle at var(--cx, 70%) var(--cy, 40%), rgba(157, 131, 207, 0.1), transparent 70%);
		pointer-events: none;
	}
	.hero-inner {
		position: relative;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 28px;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(28px, 4vw, 56px);
		align-items: center;
	}

	.hero-title {
		font-family: 'Sora', system-ui, sans-serif;
		font-weight: 600;
		font-size: clamp(2.7rem, 5vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
		max-width: 19ch;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.26em;
	}
	.hero-title span {
		border-radius: 10px;
		padding: 0 0.08em;
		transition:
			background 0.18s,
			color 0.18s,
			transform 0.18s;
	}
	.hero-title span:hover {
		background: #9d83cf;
		color: #fff;
		transform: rotate(-1.2deg);
	}
	.hero-title .jeu {
		cursor: pointer;
		text-decoration: underline dotted #ffd77a;
		text-underline-offset: 10px;
	}
	.hero-title .jeu-jaune:hover {
		background: #ffd77a;
		color: #17131f;
	}

	.hero-lede {
		color: #6c6580;
		margin-top: 22px;
		max-width: 44ch;
		font-size: 1.06rem;
	}
	.hero-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 32px;
	}
	.hero-actions .btn {
		border-radius: 999px;
		padding: 16px 32px;
		font-size: 15.5px;
	}

	.hero-atelier {
		font-family: 'Sora', sans-serif;
		font-size: 13.5px;
		color: #6c6580;
		margin-top: 28px;
		padding-top: 22px;
		border-top: 1px solid #e7e3f2;
	}

	.hero-zone {
		position: relative;
		aspect-ratio: 1 / 1.06;
		border-radius: 48px;
		background: #f7f5fc;
		overflow: hidden;
	}
	.hero-zone model-viewer {
		/* <model-viewer> se comporte comme un élément remplacé (cf. <img>,
		   <video>) : position:absolute + inset seuls ne l'étirent pas, il
		   retombe sur sa taille par défaut de 300×150px. width/height
		   explicites forcent l'étirement. */
		position: absolute;
		left: 0;
		right: 0;
		top: 70px;
		bottom: 78px;
		width: 100%;
		height: calc(100% - 148px);
	}

	.mark {
		position: absolute;
		width: 26px;
		height: 26px;
	}
	.mark-tl {
		left: 22px;
		top: 22px;
		border-left: 1.5px solid #9d83cf;
		border-top: 1.5px solid #9d83cf;
		border-radius: 5px 0 0 0;
	}
	.mark-tr {
		right: 22px;
		top: 22px;
		border-right: 1.5px solid #9d83cf;
		border-top: 1.5px solid #9d83cf;
		border-radius: 0 5px 0 0;
	}
	.mark-bl {
		left: 22px;
		bottom: 22px;
		border-left: 1.5px solid #9d83cf;
		border-bottom: 1.5px solid #9d83cf;
		border-radius: 0 0 0 5px;
	}
	.mark-br {
		right: 22px;
		bottom: 22px;
		border-right: 1.5px solid #9d83cf;
		border-bottom: 1.5px solid #9d83cf;
		border-radius: 0 0 5px 0;
	}

	.zone-shadow {
		position: absolute;
		left: 8%;
		right: 8%;
		bottom: 74px;
		height: 26px;
		border-radius: 999px;
		background: radial-gradient(50% 50%, rgba(23, 19, 31, 0.16), transparent 72%);
		pointer-events: none;
	}

	.zone-bar {
		position: absolute;
		left: 22px;
		right: 22px;
		bottom: 22px;
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}
	.coloris {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.coloris button {
		width: 30px;
		height: 30px;
		border-radius: 999px;
		border: 1.5px solid #e7e3f2;
		cursor: pointer;
		padding: 0;
	}
	.coloris button.on {
		border-color: #17131f;
	}
	.coloris button:focus-visible {
		outline: 2px solid #9d83cf;
		outline-offset: 2px;
	}

	/* Bouton d'import : même gabarit qu'un rond de coloris (30px, intégré
	   à la même rangée) plutôt qu'un pavé texte séparé — le pointillé le
	   distingue des vrais coloris comme une case "ajouter". */
	.import {
		width: 30px;
		height: 30px;
		border-radius: 999px;
		border: 1.5px dashed #9d83cf;
		background: #fff;
		color: #9d83cf;
		display: grid;
		place-items: center;
		cursor: pointer;
		flex-shrink: 0;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.import:hover {
		background: #9d83cf;
		color: #fff;
	}
	.import:focus-within {
		outline: 2px solid #9d83cf;
		outline-offset: 2px;
	}
	.import input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero-zone {
			aspect-ratio: 1 / 1;
			/* Le t-shirt passe avant le texte sur mobile. */
			order: -1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-title span {
			transition: none;
		}
	}
</style>
