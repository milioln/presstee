---
// Hero de la page d'accueil — t-shirt 3D interactif dans un gabarit
// d'impression. Repris de la maquette fournie par Milio
// (design_handoff_hero/), avec le vrai modèle 3D du configurateur
// (<model-viewer>, glTF + texture composée) à la place du rendu Three.js
// maison de la maquette — voir src/scripts/hero/tshirt-hero.ts.
---

<section class="hero" id="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span class="jeu" data-jeu="couleur">Votre textile</span><br />
				<span class="jeu" data-jeu="placement">personnalisé</span><br />
				<span>en</span> <span class="jeu jeu-jaune" data-jeu="spin">3 clics.</span>
			</h1>

			<div class="hero-actions">
				<a class="btn btn-primary" href="/commencer">Lancez le test</a>
				<a class="btn btn-secondary" href="/produits/t-shirts">Voir le catalogue</a>
			</div>

			<p class="hero-atelier">Atelier à Angoulême, Charente</p>
		</div>

		<div class="hero-zone-wrap">
		<div class="hero-zone" id="heroZone">
			<span class="mark mark-tl"></span>
			<span class="mark mark-tr"></span>
			<span class="mark mark-bl"></span>
			<span class="mark mark-br"></span>

			<p class="hero-atelier-mobile">Atelier à Angoulême, Charente</p>

			<span class="zone-shadow"></span>

			<model-viewer
				id="heroStage"
				src="/personnalisateur/model/scene.gltf"
				camera-controls
				touch-action="pan-y"
				interaction-prompt="none"
				shadow-intensity="1"
				camera-orbit="0deg 85deg 92%"
				min-camera-orbit="auto 55deg auto"
				max-camera-orbit="auto 115deg auto"
			></model-viewer>

			<div class="zone-bar">
				<div class="coloris" id="heroColoris">
					<button type="button" data-nom="Blanc" aria-label="Coloris blanc" style="background:#ffffff"></button>
					<button type="button" data-nom="Sable" aria-label="Coloris sable" style="background:#E4D6BD"></button>
					<button type="button" data-nom="Indigo" aria-label="Coloris indigo" style="background:#9B07FF"></button>
					<button type="button" data-nom="Noir" aria-label="Coloris noir" style="background:#1B1B1F"></button>
					<button type="button" data-nom="Jaune Presstee" aria-label="Coloris jaune Presstee" style="background:#FFC500"></button>
					<button type="button" data-nom="Bleu marine" aria-label="Coloris bleu marine" style="background:#20304F"></button>
					<button type="button" data-nom="Rouge" aria-label="Coloris rouge" style="background:#BF3B32"></button>
					<button type="button" data-nom="Vert bouteille" aria-label="Coloris vert bouteille" style="background:#1F5A4A"></button>
				</div>
			</div>

			<button type="button" class="fullscreen-btn" id="heroFullscreen" aria-label="Afficher le t-shirt 3D en plein écran" title="Plein écran">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M8 3H5a2 2 0 0 0-2 2v3" /><path d="M16 3h3a2 2 0 0 1 2 2v3" /><path d="M8 21H5a2 2 0 0 1-2-2v-3" /><path d="M16 21h3a2 2 0 0 0 2-2v-3" />
				</svg>
			</button>
		</div>

		<label class="logo-hint" title="Importer votre visuel">
			<svg class="logo-hint-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M17 1l4 4-4 4" />
				<path d="M3 11V9a4 4 0 0 1 4-4h14" />
				<path d="M7 23l-4-4 4-4" />
				<path d="M21 13v2a4 4 0 0 1-4 4H3" />
			</svg>
			<span>Changer le logo</span>
			<input id="heroFile" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
		</label>
		</div>
	</div>
</section>

<script>
	const hero = document.getElementById('hero');

	// Lueur qui suit le curseur, propre au héros (Milio, 2026-09-15 :
	// étendue à tout le site un temps, puis revenue ici seulement — les
	// retours étaient partagés sur le reste du site). Coûte juste deux
	// variables CSS mises à jour, rien créé ni supprimé.
	hero?.addEventListener('mousemove', (e) => {
		const r = hero.getBoundingClientRect();
		const x = (e.clientX - r.left) / r.width;
		const y = (e.clientY - r.top) / r.height;
		hero.style.setProperty('--cx', (x * 100).toFixed(1) + '%');
		hero.style.setProperty('--cy', (y * 100).toFixed(1) + '%');
	});

	// Import différé (comme sur /personnaliser) : la bibliothèque
	// @google/model-viewer (WebGL) et le modèle 3D ne bloquent plus le
	// bundle principal de la page la plus visitée du site — le
	// chargement démarre dès l'exécution du script, donc le t-shirt
	// arrive dès l'affichage de la page, juste sans retarder le reste.
	import('@google/model-viewer').then(() => import('../scripts/hero/tshirt-hero')).then(({ initHero3D }) => initHero3D());

	// Plein écran sur la vignette (t-shirt + palette), pas sur toute la
	// section : plus lisible sur mobile pour examiner le visuel de près.
	const heroZone = document.getElementById('heroZone');
	const fsBtn = document.getElementById('heroFullscreen');
	fsBtn?.addEventListener('click', () => {
		if (document.fullscreenElement) document.exitFullscreen();
		else heroZone?.requestFullscreen();
	});
	document.addEventListener('fullscreenchange', () => {
		const active = document.fullscreenElement === heroZone;
		heroZone?.classList.toggle('is-fullscreen', active);
		fsBtn?.setAttribute('aria-label', active ? 'Quitter le plein écran' : 'Afficher le t-shirt 3D en plein écran');
	});
</script>

<style>
	.hero {
		position: relative;
		padding: clamp(48px, 5vw, 76px) 0 clamp(52px, 6vw, 84px);
		background-color: #fff;
		background-image: linear-gradient(rgba(157, 131, 207, 0.22) 1.5px, transparent 1.5px), linear-gradient(90deg, rgba(157, 131, 207, 0.22) 1.5px, transparent 1.5px);
		background-size: 44px 44px;
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(420px circle at var(--cx, 70%) var(--cy, 40%), rgba(155, 7, 255, 0.1), transparent 70%);
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero::before {
			display: none;
		}
	}
	@keyframes heroSpinBounce {
		0% {
			transform: scale(1) rotate(0);
		}
		30% {
			transform: scale(1.045) rotate(-2deg);
		}
		60% {
			transform: scale(0.985) rotate(1.2deg);
		}
		100% {
			transform: scale(1) rotate(0);
		}
	}
	.hero-zone.spin-bounce {
		animation: heroSpinBounce 0.5s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-zone.spin-bounce {
			animation: none;
		}
	}
	.hero-inner {
		position: relative;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 28px;
		display: grid;
		/* Deux colonnes de même largeur (Milio, 2026-09-15 : « la partie
		   gauche fasse la même largeur que la partie droite ») — un essai
		   précédent élargissait le texte au détriment de la vignette 3D,
		   qui s'en trouvait réduite ; ce n'était pas voulu. */
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(28px, 4vw, 56px);
		/* Les deux colonnes occupent désormais la même hauteur (Milio,
		   2026-09-15 : « même hauteur pour la gauche que la droite ») —
		   .hero-copy répartit alors son contenu du haut au bas de cette
		   hauteur commune plutôt que de rester centré sur lui-même. */
		align-items: stretch;
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Entrée orchestrée au chargement — le titre, les actions puis le
	   t-shirt se posent l'un après l'autre plutôt que d'apparaître d'un
	   bloc, dans l'esprit de la révélation déjà en place sur le résultat
	   du quiz (commencer.css, qzFadeUp). Toujours visible sans JS : une
	   animation CSS pure va à son terme même si le script échoue. */
	@keyframes heroRise {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.hero-title,
	.hero-actions,
	.hero-atelier,
	.hero-zone-wrap {
		animation: heroRise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.hero-title {
		animation-delay: 0.02s;
	}
	.hero-actions {
		animation-delay: 0.14s;
	}
	.hero-atelier {
		animation-delay: 0.22s;
	}
	.hero-zone-wrap {
		animation-delay: 0.1s;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-title,
		.hero-actions,
		.hero-atelier,
		.hero-zone-wrap {
			animation: none;
		}
	}

	.hero-title {
		/* 3 lignes fixes ("Votre textile" / "personnalisé" / "en 3 clics.")
		   via de vrais <br> plutôt qu'un retour à la ligne naturel — même
		   découpage sur ordinateur et mobile (Milio, 2026-09-15). Un <br>
		   n'a aucun effet dans un conteneur flex, d'où le retour à un bloc
		   normal ; chaque mot reste en inline-block pour garder son fond/
		   sa rotation au survol. */
		font-family: 'Anton', system-ui, sans-serif;
		font-weight: 400;
		/* Légèrement agrandi (Milio, 2026-09-15 : « agrandis-le un tout
		   petit peu ») — 2.7rem → 2.9rem au plancher mobile. */
		font-size: clamp(3.2rem, 5vw, 4.6rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
		max-width: 19ch;
		color: var(--jaune);
	}
	.hero-title span {
		display: inline-block;
		border-radius: 10px;
		padding: 0 0.08em;
		transition:
			background 0.18s,
			color 0.18s,
			transform 0.18s;
	}
	.hero-title span:hover {
		background: #9B07FF;
		color: #fff;
		transform: rotate(-1.2deg);
	}
	.hero-title .jeu {
		cursor: pointer;
		/* Trait plein et fin plutôt que pointillé (Milio, 2026-09-15). */
		text-decoration: underline solid var(--indigo);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 10px;
	}
	.hero-title .jeu-jaune:hover {
		background: #FFC500;
		color: #17131f;
	}

	.hero-actions {
		/* Les deux CTA restent collés côte à côte (Milio, 2026-09-15 :
		   « tu n'as pas fait comme je t'ai montré... colle les deux
		   boutons à côté ») — l'essai précédent les écartait jusqu'aux
		   bords avec justify-content:space-between ; on grossit plutôt
		   les boutons eux-mêmes pour occuper la largeur. */
		display: flex;
		gap: 12px;
		flex-wrap: nowrap;
		margin-top: 26px;
	}
	.hero-actions .btn {
		/* Transparents plutôt que pleins noirs (Milio, 2026-09-15) — .btn
		   reste plein ailleurs sur le site (bouton partagé), ce style ne
		   touche que les deux CTA du hero. Plus larges (Milio,
		   2026-09-15 : « fais-les plus gros pour qu'ils soient plus
		   larges »), hauteur inchangée (padding vertical constant) ; pas
		   de flex-wrap pour qu'ils restent toujours collés côte à côte. */
		border-radius: 999px;
		padding: 15px 34px;
		font-size: 16px;
		background: transparent;
		color: var(--encre);
		border: 1.5px solid var(--encre);
		transition:
			background 0.18s,
			color 0.18s,
			border-color 0.18s;
	}
	.hero-actions .btn:hover {
		background: var(--encre);
		color: #fff;
	}

	.hero-atelier {
		/* Remontée (Milio, 2026-09-15) — moins d'espace au-dessus
		   maintenant que le titre tient sur 3 lignes courtes. */
		font-family: 'Sora', sans-serif;
		font-size: 13.5px;
		color: #6c6580;
		margin-top: 16px;
		padding-top: 14px;
		border-top: 1px solid #e7e3f2;
	}
	/* Doublon affiché uniquement sur mobile, en petit repère discret en
	   haut de la vignette 3D (cf. media query plus bas) — évite un
	   réagencement CSS Grid complexe pour un simple bloc de texte. */
	.hero-atelier-mobile {
		display: none;
	}

	.hero-zone-wrap {
		position: relative;
	}
	.hero-zone {
		/* Pas de fond plein : le t-shirt s'incruste directement sur la
		   grille de la section plutôt que dans une carte séparée. */
		position: relative;
		aspect-ratio: 1 / 1.06;
	}
	.hero-zone model-viewer {
		/* <model-viewer> se comporte comme un élément remplacé (cf. <img>,
		   <video>) : position:absolute + inset seuls ne l'étirent pas, il
		   retombe sur sa taille par défaut de 300×150px. width/height
		   explicites forcent l'étirement. Marges resserrées au plus près
		   de ce qu'elles doivent vraiment dégager (Milio, 2026-09-15 : « il
		   y a de l'espace en bas jusqu'à la palette et en haut jusqu'à
		   atelier ») — 62px en haut pour dégager le bouton plein écran
		   (top:22px, 38px de haut), 58px en bas pour dégager la barre de
		   coloris, au lieu de 70/78px choisis avec une marge trop large.
		   Le t-shirt dispose ainsi d'une zone plus grande, moins souvent
		   coupé au bord en tournant. */
		position: absolute;
		left: 0;
		right: 0;
		top: 62px;
		bottom: 58px;
		width: 100%;
		height: calc(100% - 120px);
	}

	.mark {
		position: absolute;
		width: 26px;
		height: 26px;
	}
	.mark-tl {
		left: 22px;
		top: 22px;
		border-left: 1.5px solid #9B07FF;
		border-top: 1.5px solid #9B07FF;
		border-radius: 5px 0 0 0;
	}
	.mark-tr {
		right: 22px;
		top: 22px;
		border-right: 1.5px solid #9B07FF;
		border-top: 1.5px solid #9B07FF;
		border-radius: 0 5px 0 0;
	}
	.mark-bl {
		left: 22px;
		bottom: 22px;
		border-left: 1.5px solid #9B07FF;
		border-bottom: 1.5px solid #9B07FF;
		border-radius: 0 0 0 5px;
	}
	.mark-br {
		right: 22px;
		bottom: 22px;
		border-right: 1.5px solid #9B07FF;
		border-bottom: 1.5px solid #9B07FF;
		border-radius: 0 0 5px 0;
	}

	.zone-shadow {
		position: absolute;
		left: 8%;
		right: 8%;
		bottom: 74px;
		height: 26px;
		border-radius: 999px;
		background: radial-gradient(50% 50%, rgba(23, 19, 31, 0.16), transparent 72%);
		pointer-events: none;
	}

	.zone-bar {
		position: absolute;
		left: 22px;
		right: 22px;
		bottom: 22px;
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	.fullscreen-btn {
		position: absolute;
		top: 22px;
		right: 22px;
		z-index: 2;
		width: 38px;
		height: 38px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		border: 1.5px solid #e7e3f2;
		background: #fff;
		color: #17131f;
		cursor: pointer;
		box-shadow: 0 6px 18px rgba(23, 19, 31, 0.14);
		transition:
			border-color 0.18s,
			transform 0.18s;
	}
	.fullscreen-btn:hover {
		border-color: #9B07FF;
		transform: scale(1.06);
	}
	.fullscreen-btn:focus-visible {
		outline: 2px solid #9B07FF;
		outline-offset: 2px;
	}
	/* Plein écran natif (Fullscreen API) : la vignette occupe tout l'écran,
	   le t-shirt garde sa place (inset déjà en %) et la barre de coloris
	   remonte un peu pour rester confortable au doigt sur mobile. */
	.hero-zone:fullscreen {
		aspect-ratio: auto;
		width: 100vw;
		height: 100vh;
		background: #fff;
		display: flex;
		align-items: center;
	}
	.hero-zone.is-fullscreen .zone-bar {
		bottom: 32px;
	}
	.coloris {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.coloris button {
		width: 30px;
		height: 30px;
		border-radius: 999px;
		border: 1.5px solid #e7e3f2;
		cursor: pointer;
		padding: 0;
		box-shadow: 0 4px 14px rgba(23, 19, 31, 0.12);
	}
	.coloris button.on {
		border-color: #17131f;
	}
	.coloris button:focus-visible {
		outline: 2px solid #9B07FF;
		outline-offset: 2px;
	}

	/* Pastille flottante à cheval sur le bord de la vignette (déborde vers
	   la gauche) plutôt qu'un élément posé bien à l'intérieur du cadre —
	   la superposition carte/pastille crée un effet de profondeur (3D)
	   et rend le contrôle plus visible qu'un simple lien texte. Toute la
	   pastille est cliquable (label enveloppant l'input masqué). */
	.logo-hint {
		/* Réduit (Milio, 2026-09-15 : « diminue un peu la taille »), sur
		   ordinateur comme sur téléphone. */
		position: absolute;
		top: 50%;
		left: -18px;
		transform: translateY(-50%);
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 6px;
		background: #fff;
		border: 1.5px solid #e7e3f2;
		border-radius: 999px;
		padding: 9px 16px 9px 11px;
		box-shadow: 0 10px 28px rgba(23, 19, 31, 0.14);
		cursor: pointer;
		color: #17131f;
		transition:
			transform 0.18s,
			box-shadow 0.18s,
			border-color 0.18s;
	}
	.logo-hint:hover {
		transform: translateY(-50%) translateX(-5px);
		border-color: #9B07FF;
		box-shadow: 0 14px 32px rgba(157, 131, 207, 0.3);
	}
	.logo-hint span {
		font-family: 'Sora', sans-serif;
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.logo-hint-icon {
		flex-shrink: 0;
		color: #9B07FF;
	}
	.logo-hint:focus-within {
		outline: 2px solid #9B07FF;
		outline-offset: 2px;
	}
	.logo-hint input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	@media (max-width: 520px) {
		.logo-hint {
			left: -8px;
			padding: 7px 13px 7px 9px;
		}
		.logo-hint span {
			font-size: 10.5px;
		}
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero-zone-wrap {
			/* Le t-shirt passe avant le texte sur mobile. */
			order: -1;
		}
		.hero-zone {
			aspect-ratio: 1 / 1;
			/* Pleine largeur, alignée sur les CTA en dessous (Milio,
			   2026-09-15 : « la même largeur que les deux boutons ») — un
			   essai précédent l'avait réduite à 86 %, ce qui la décalait
			   par rapport au texte et aux boutons. */
			max-width: 100%;
		}
		.hero-atelier {
			display: none;
		}
		/* Repositionnée en petit repère discret en haut de la vignette
		   plutôt qu'en ligne de texte centrée pleine largeur sous le
		   modèle (Milio, 2026-09-15 : « trop important », « un endroit
		   bien calé ») — .hero-zone a déjà position:relative, elle sert
		   directement d'ancrage. */
		.hero-atelier-mobile {
			display: block;
			position: absolute;
			/* Calée à côté du repère de coin haut-gauche, pas centrée pleine
			   largeur : un texte centré chevauchait le bouton plein écran
			   posé en haut à droite (top:22px/right:22px, 38px de large). */
			top: 26px;
			left: 56px;
			right: 70px;
			z-index: 1;
			font-family: 'Sora', sans-serif;
			font-size: 10.5px;
			letter-spacing: 0.01em;
			color: rgba(108, 101, 128, 0.75);
			text-align: left;
			margin: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			pointer-events: none;
		}
		/* Titre du hero raccourci et centré (Milio, 2026-09-15) : après un
		   essai en 3 lignes forcées justifiées ("Obtenez vos" / "textiles
		   personnalisés" / "en 3 clics.") jugé peu réussi une fois en ligne
		   — trop d'éléments étirés bord à bord d'affilée, texte/H1 +
		   boutons —, texte raccourci ("Textile personnalisé en 3 clics.",
		   sans perdre le sens ni les mots interactifs) et retour à un
		   simple retour à la ligne naturel, centré. */
		.hero-copy {
			text-align: center;
		}
		.hero-title {
			max-width: none;
		}
		.hero-actions {
			justify-content: center;
		}
		/* Les 8 coloris tiennent sur une seule ligne plutôt que de passer à
		   la ligne sur les petits écrans. */
		.coloris {
			flex-wrap: nowrap;
			gap: 6px;
		}
		.coloris button {
			width: 26px;
			height: 26px;
			flex-shrink: 0;
		}
	}
	@media (max-width: 560px) {
		/* Rythme resserré pour que les deux boutons d'action restent
