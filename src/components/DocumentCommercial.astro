---
// Document commercial (devis / facture) — recréation pixel du gabarit
// de design de design_handoff_devis_facture/README.md.
//
// Émetteur, tarification et zones d'impression viennent de la config du
// site ; client, dates, objet, lignes et frais sont des props — fournis
// par src/pages/devis/[numero].astro et facture/[numero].astro, qui les
// lisent depuis une commande en base au moment du build
// (getStaticPaths, voir ces routes et src/lib/commandes.ts).
import { siteConfig } from '../config/site';
import { PALIERS_TARIF, prixVente } from '../config/tarification';
import { getZoneImpressionCm, coutBaseSupportUnique, type Garment, type Emplacement, type TailleCode } from '../config/parametres-metier';

export interface Marquage {
  technique: string;
  nbCouleurs: number;
  emplacement: Emplacement;
  visuelUrl: string | null;
}

export interface LigneCommande {
  garment: Garment;
  support: string;
  coloris: { nom: string; hex: string };
  tailles: Partial<Record<TailleCode, number>>;
  quantite: number;
  marquages: Marquage[];
}

export interface FraisCommande {
  libelle: string;
  detail: string;
  quantite: number;
  prixUnitaireHT: number;
}

export interface ClientCommande {
  nom: string;
  adresse: string[];
  contact?: string | null;
}

interface Props {
  type?: 'devis' | 'facture';
  numero: string;
  dateEmission: string; // ISO (AAAA-MM-JJ)
  dateEcheance: string; // ISO (AAAA-MM-JJ)
  objet: string;
  client: ClientCommande;
  lignes: LigneCommande[];
  frais?: FraisCommande[];
}

const { type = 'devis', numero, dateEmission: dateEmissionProp, dateEcheance: dateEcheanceProp, objet, client, lignes: commande, frais = [] }: Props = Astro.props;
const facture = type === 'facture';

const typeLabel = facture ? 'Facture' : 'Devis';
const dateLabel = facture ? 'Échéance' : 'Valable jusqu’au';
const conditionsTitre = facture ? 'Conditions de règlement' : 'Validité et règlement';
const conditionsTexte = facture
  ? 'Règlement à 30 jours à compter de la date d’émission, par virement bancaire. Tout retard de paiement entraîne des pénalités au taux légal en vigueur.'
  : 'Devis valable 30 jours à compter de la date d’émission. Lancement de la production après retour signé et validation du bon à tirer. Règlement par virement bancaire.';

// Format identique à celui prescrit par le README (Intl.DateTimeFormat
// fr-FR, jour/mois en toutes lettres/année).
const fmtDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const dateEmissionLabel = fmtDate.format(new Date(dateEmissionProp));
const dateValeur = fmtDate.format(new Date(dateEcheanceProp));

const fmtPriceIntl = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
function fmtPrice(n: number): string {
  return fmtPriceIntl.format(n);
}

// Bordure de vignette : une teinte claire garde la bordure neutre du
// site (--ligne), une teinte foncée reprend sa propre couleur pour ne
// pas dessiner un liseré clair disproportionné sur un aplat sombre.
// Même formule de luminance relative (WCAG) que
// src/scripts/personnalisateur/color-utils.ts — dupliquée plutôt que
// partagée : ce composant tourne côté serveur, sans lien avec le
// module client du configurateur.
function estClair(hex: string): boolean {
  const canal = (v: number) => {
    v /= 255;
    return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
  };
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  const lum = 0.2126 * canal(r) + 0.7152 * canal(g) + 0.0722 * canal(b);
  return lum > 0.6;
}

const EMPLACEMENT_LABEL: Record<Emplacement, string> = { face: 'Face', coeur: 'Cœur', dos: 'Dos' };

// Réplique la logique de src/scripts/personnalisateur/derived.ts
// (palierActuel), paramétrée par une quantité explicite plutôt que
// l'état S du configurateur : ce composant tourne côté serveur, sur une
// commande déjà figée, pas sur un projet en cours d'édition.
function palierPour(qty: number) {
  return PALIERS_TARIF.find((p) => qty >= p.min && (p.max == null || qty <= p.max)) ?? PALIERS_TARIF[PALIERS_TARIF.length - 1];
}

type LigneAffichee =
  | { kind: 'produit'; vignetteHex: string; titre: string; detail: string; tailles: Partial<Record<TailleCode, number>>; quantite: number; prixUnitaireHT: number }
  | { kind: 'marquage'; visuelUrl: string | null; titre: string; detail: string; quantite: number; prixUnitaireHT: number };

// Chaque support de la commande devient plusieurs lignes du document :
// une pour le support vierge (photo du textile sans visuel), une par
// marquage déposé dessus. Le prix par pièce (tarification.ts) ne
// distingue pas encore le coût du support de celui d'un marquage — sur
// ce point le modèle de prix actuel est volontairement simplifié (une
// seule formule, cf. commentaire de coutBaseSupportUnique dans
// parametres-metier.ts) : en attendant une vraie décomposition, le prix
// par pièce est réparti à parts égales entre les lignes issues d'une
// même commande, exactement comme dans le panier
// (src/pages/panier.astro, markLine()).
const lignesAffichees: LigneAffichee[] = commande.flatMap((c) => {
  const palier = palierPour(c.quantite);
  const prixPiece = prixVente(coutBaseSupportUnique, palier.marge);
  const nbLignes = 1 + c.marquages.length;
  const prixParLigne = prixPiece / nbLignes;

  const ligneProduit: LigneAffichee = {
    kind: 'produit',
    vignetteHex: c.coloris.hex,
    titre: c.support,
    detail: `Coloris ${c.coloris.nom}`,
    tailles: c.tailles,
    quantite: c.quantite,
    prixUnitaireHT: prixParLigne,
  };

  const lignesMarquage: LigneAffichee[] = c.marquages.map((m) => ({
    kind: 'marquage',
    visuelUrl: m.visuelUrl,
    titre: m.technique,
    detail: `${m.nbCouleurs >= 12 ? '12 et plus' : m.nbCouleurs} couleur${m.nbCouleurs > 1 ? 's' : ''} · ${EMPLACEMENT_LABEL[m.emplacement]}, largeur ${getZoneImpressionCm(c.garment, m.emplacement)} cm`,
    quantite: c.quantite,
    prixUnitaireHT: prixParLigne,
  }));

  return [ligneProduit, ...lignesMarquage];
});

const totalHT = lignesAffichees.reduce((s, l) => s + l.quantite * l.prixUnitaireHT, 0) + frais.reduce((s, f) => s + f.quantite * f.prixUnitaireHT, 0);
// TVA non applicable tant que siteConfig.siret est vide (site pas encore
// immatriculé) : cf. README, « Comportement ».
const avecSiret = siteConfig.siret !== '';
const tva = avecSiret ? totalHT * 0.2 : 0;
const totalTTC = totalHT + tva;

const adresseEmetteur = `${siteConfig.adresse.ville}, ${siteConfig.adresse.departement}`;
const siretEmetteur = siteConfig.siret || 'à compléter';
---

<div class="print-actions">
	<button type="button" class="btn" onclick="window.print()">Imprimer / Enregistrer en PDF</button>
</div>

<table class="sheet">
<tbody><tr><td class="sheet-cell">
	<div class="doc">
		<img class="watermark" src="/logo/presstee-icone.svg" alt="" aria-hidden="true" />

		<div class="doc-head">
			<img class="logo" src="/logo/presstee-horizontal.svg" alt="Presstee" />
			<div class="doc-head-right">
				<span class="badge">{typeLabel}</span>
				<div class="numero">{numero}</div>
				<div class="dates">
					<span>Émis le</span><span class="val">{dateEmissionLabel}</span>
					<span>{dateLabel}</span><span class="val">{dateValeur}</span>
				</div>
			</div>
		</div>

		<div class="parties">
			<div class="carte">
				<div class="surtitre">Émetteur</div>
				<div class="nom">{siteConfig.nom}</div>
				<div class="adresse">
					{adresseEmetteur}
					<br />
					{siteConfig.email} · {siteConfig.telephone}
				</div>
				<div class="appoint">
					SIRET <span class="val">{siretEmetteur}</span>
				</div>
			</div>
			<div class="carte carte-client">
				<div class="surtitre">Client</div>
				<div class="nom">{client.nom}</div>
				<div class="adresse">
					{client.adresse.map((ligne, i) => (
						<>
							{i > 0 && <br />}
							{ligne}
						</>
					))}
				</div>
				{client.contact && (
					<div class="appoint">
						Contact <span class="val">{client.contact}</span>
					</div>
				)}
			</div>
		</div>

		<div class="objet">
			<span class="label">Objet</span>
			<span class="valeur">{objet}</span>
		</div>

		<div class="tableau">
			<div class="ligne ligne-entete">
				<span>Visuel</span><span>Désignation</span><span class="num">Qté</span><span class="num">PU HT</span><span class="num">Total HT</span>
			</div>

			{
				lignesAffichees.map((l) =>
					l.kind === 'produit' ? (
						<div class="ligne ligne-produit">
							<div class="vignette vignette-produit" style={{ background: l.vignetteHex, borderColor: estClair(l.vignetteHex) ? 'var(--ligne)' : l.vignetteHex }} />
							<div class="designation">
								<span class="nom-support">{l.titre}</span>
								<span class="detail">{l.detail}</span>
								<div class="tailles">
									{Object.entries(l.tailles).map(([taille, n]) => (
										<span class="pastille">
											{taille} · {n}
										</span>
									))}
								</div>
							</div>
							<span class="num">{l.quantite}</span>
							<span class="num">{fmtPrice(l.prixUnitaireHT)}</span>
							<span class="num total">{fmtPrice(l.quantite * l.prixUnitaireHT)}</span>
						</div>
					) : (
						<div class="ligne ligne-marquage">
							<div class="vignette vignette-frais">{l.visuelUrl ? <img src={l.visuelUrl} alt="" /> : l.titre}</div>
							<div class="designation">
								<span class="nom-support">{l.titre}</span>
								<span class="detail">{l.detail}</span>
							</div>
							<span class="num">{l.quantite}</span>
							<span class="num">{fmtPrice(l.prixUnitaireHT)}</span>
							<span class="num total">{fmtPrice(l.quantite * l.prixUnitaireHT)}</span>
						</div>
					)
				)
			}

			{
				frais.map((f) => (
					<div class="ligne ligne-frais">
						<div class="vignette vignette-frais">écrans</div>
						<div class="designation">
							<span class="nom-support">{f.libelle}</span>
							<span class="detail">{f.detail}</span>
						</div>
						<span class="num">{f.quantite}</span>
						<span class="num">{fmtPrice(f.prixUnitaireHT)}</span>
						<span class="num total">{fmtPrice(f.quantite * f.prixUnitaireHT)}</span>
					</div>
				))
			}
		</div>

		<div class="totaux-wrap">
			<div class="totaux">
				{
					avecSiret && (
						<>
							<div class="ligne-totaux">
								<span>Total HT</span>
								<span class="montant">{fmtPrice(totalHT)}</span>
							</div>
							<div class="ligne-totaux">
								<span>TVA 20 %</span>
								<span class="montant">{fmtPrice(tva)}</span>
							</div>
						</>
					)
				}
				<div class="ttc">
					<span class="ttc-label">{avecSiret ? 'Total TTC' : 'Total HT'}</span>
					<span class="ttc-montant">{fmtPrice(avecSiret ? totalTTC : totalHT)}</span>
				</div>
			</div>
		</div>

		<div class:list={['conditions-wrap', { 'sans-signature': facture }]}>
			<div class="conditions">
				<div class="titre">{conditionsTitre}</div>
				<div class="texte">{conditionsTexte}</div>
				<div class="banque">
					<span>IBAN</span><span class="val">FR76 0000 0000 0000 0000 0000 000</span>
					<span>BIC</span><span class="val">XXXXFRPPXXX</span>
				</div>
			</div>
			{
				!facture && (
					<div class="signature">
						<div class="titre">Bon pour accord</div>
						<div class="soustitre">Date, nom et signature du client</div>
						<div class="espace" />
						<div class="trait" />
					</div>
				)
			}
		</div>
	</div>
</td></tr></tbody>
<tfoot><tr><td class="sheet-cell sheet-cell-foot">
	<div class="doc-foot">
		<span>
			{siteConfig.nom} · {adresseEmetteur} · {siteConfig.email} · SIRET {siretEmetteur}
			{!avecSiret && ' · TVA non applicable jusqu’à immatriculation'}
		</span>
		<span class="numero-foot">{numero}</span>
	</div>
</td></tr></tfoot>
</table>

<style>
	/* Un <table> plutôt qu'une simple <div> : c'est la technique la plus
	   fiable pour répéter le pied de page sur chaque page imprimée — un
	   <tfoot> est automatiquement reproduit par les navigateurs quand le
	   tableau se découpe sur plusieurs pages (position:fixed gère mal la
	   hauteur réservée, cf. README « Impression »). La marge de 13 mm vit
	   dans le padding des cellules plutôt que sur .sheet ou @page, pour
	   qu'elle s'applique identiquement à l'écran et à l'impression. */
	.sheet {
		width: 210mm;
		margin: 0 auto;
		background: #fff;
		border-collapse: collapse;
		font-family: 'Manrope', system-ui, sans-serif;
		color: var(--encre);
		font-size: 14px;
		line-height: 1.5;
	}
	.sheet-cell {
		padding: 13mm 13mm 0 13mm;
	}
	.sheet-cell-foot {
		padding: 0 13mm 13mm 13mm;
	}

	.print-actions {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
	}

	.doc {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.watermark {
		position: absolute;
		width: 460px;
		height: auto;
		left: 130px;
		top: 300px;
		opacity: 0.06;
		pointer-events: none;
	}

	.doc-head {
		position: relative;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 32px;
	}
	.doc-head .logo {
		width: 186px;
		height: auto;
	}
	.doc-head-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		height: 30px;
		padding: 0 18px;
		border-radius: 999px;
		background: var(--jaune);
		font-family: 'Sora', sans-serif;
		font-size: 12.5px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.numero {
		font-family: 'Sora', sans-serif;
		font-size: 27px;
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.dates {
		display: grid;
		grid-template-columns: auto auto;
		gap: 2px 14px;
		font-size: 12.5px;
		color: var(--gris);
		text-align: right;
	}
	.dates .val {
		color: var(--encre);
		font-weight: 600;
	}

	.parties {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.carte {
		border: 1px solid var(--ligne);
		border-radius: var(--r);
		padding: 13px 18px;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}
	.carte-client {
		background: var(--lavande);
	}
	.surtitre {
		font-family: 'Sora', sans-serif;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gris);
	}
	.nom {
		font-family: 'Sora', sans-serif;
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.adresse {
		color: var(--gris);
		font-size: 13px;
		orphans: 3;
		widows: 3;
	}
	.appoint {
		margin-top: 4px;
		font-size: 12px;
		color: var(--gris);
	}
	.appoint .val {
		color: var(--encre);
		font-weight: 600;
	}

	.objet {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 10px;
		padding-left: 14px;
		border-left: 2px solid var(--jaune);
	}
	.objet .label {
		font-size: 12px;
		color: var(--gris);
	}
	.objet .valeur {
		font-family: 'Sora', sans-serif;
		font-size: 15px;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.tableau {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.ligne {
		display: grid;
		grid-template-columns: 62px 1fr 54px 92px 100px;
		gap: 14px;
	}
	.num {
		text-align: right;
	}
	.ligne-entete {
		align-items: center;
		padding: 0 4px 8px;
		font-family: 'Sora', sans-serif;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gris);
		border-bottom: 1px solid var(--ligne);
	}
	.ligne-produit,
	.ligne-marquage {
		align-items: start;
		padding: 11px 4px;
		border-bottom: 1px solid var(--gris-clair);
		break-inside: avoid;
	}
	.ligne-frais {
		align-items: center;
		padding: 11px 4px;
		border-bottom: 1px solid var(--gris-clair);
		break-inside: avoid;
	}
	.vignette {
		width: 62px;
		height: 62px;
		border-radius: 14px;
		border: 1px solid var(--ligne);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.vignette img {
		width: 38px;
		height: auto;
	}
	.vignette-frais {
		background: var(--lavande);
		border-color: var(--lavande);
		font-family: 'Sora', sans-serif;
		font-size: 11px;
		font-weight: 600;
		color: var(--indigo);
		text-align: center;
		line-height: 1.2;
		padding: 4px;
	}
	.designation {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.nom-support {
		font-family: 'Sora', sans-serif;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.detail {
		font-size: 12.5px;
		color: var(--gris);
		orphans: 3;
		widows: 3;
	}
	.tailles {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.pastille {
		font-size: 11.5px;
		font-weight: 600;
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--gris-clair);
	}
	.ligne .num {
		font-family: 'Sora', sans-serif;
		font-size: 14px;
	}
	.ligne .num.total {
		font-weight: 600;
	}

	.totaux-wrap {
		position: relative;
		display: flex;
		justify-content: flex-end;
		break-inside: avoid;
	}
	.totaux {
		width: 320px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.ligne-totaux {
		display: flex;
		justify-content: space-between;
		font-size: 13.5px;
		color: var(--gris);
	}
	.ligne-totaux .montant {
		font-family: 'Sora', sans-serif;
		color: var(--encre);
	}
	.ttc {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 4px;
		padding: 14px 18px;
		border-radius: 16px;
		background: var(--indigo);
		color: #fff;
	}
	.ttc-label {
		font-family: 'Sora', sans-serif;
		font-size: 13px;
		font-weight: 500;
	}
	.ttc-montant {
		font-family: 'Sora', sans-serif;
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.conditions-wrap {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 268px;
		gap: 16px;
		align-items: stretch;
		break-inside: avoid;
	}
	.conditions-wrap.sans-signature {
		grid-template-columns: 1fr;
	}
	.conditions {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px 18px;
		border-radius: var(--r);
		background: var(--jaune);
	}
	.conditions .titre {
		font-family: 'Sora', sans-serif;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.conditions .texte {
		font-size: 13px;
		line-height: 1.55;
		orphans: 3;
		widows: 3;
	}
	.banque {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 2px 12px;
		font-size: 12.5px;
		margin-top: 2px;
	}
	.banque span:nth-child(odd) {
		color: var(--gris);
	}
	.banque .val {
		font-family: 'Sora', sans-serif;
		font-weight: 500;
	}
	.signature {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 14px 16px;
		border: 1.5px dashed var(--indigo);
		border-radius: var(--r);
	}
